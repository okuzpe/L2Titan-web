---
import Layout from '../../layouts/Layout.astro';
import CardSurface from '../../components/ui/CardSurface.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
import { buildBreadcrumb, absoluteUrl } from '../../utils/seo';
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { translate } from '../../utils/translations';
import type { NewsItem } from '../../data/news';
import { newsWebpSrcset } from '../../utils/news-images';

interface Props {
  newsItem: NewsItem;
}

export async function getStaticPaths() {
  const { news } = await import('../../data/news');

  return news.map((item) => ({
    params: { slug: item.slug },
    props: { newsItem: item },
  }));
}

const { newsItem } = Astro.props;

const lang = visitorLangFromPath(Astro.url.pathname);
const tk = (key: string, fb: string) => translate(key, lang, fb);
const resolvedTitle = newsItem.titleKey
  ? translate(newsItem.titleKey, lang, newsItem.title)
  : newsItem.title;
const resolvedSummary = newsItem.summaryKey
  ? translate(newsItem.summaryKey, lang, newsItem.summary)
  : newsItem.summary;
const resolvedContent = newsItem.contentKey
  ? translate(newsItem.contentKey, lang, newsItem.content)
  : newsItem.content;

const articleImageURL = absoluteUrl(newsItem.image);
const articleWebpSrcset = newsWebpSrcset(newsItem);
const articleUrl = absoluteUrl(`/news/${newsItem.slug}`);
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: resolvedTitle,
  description: resolvedSummary,
  image: articleImageURL,
  inLanguage: lang,
  articleSection: 'News',
  datePublished: newsItem.publishedAt,
  dateModified: newsItem.updatedAt ?? newsItem.publishedAt,
  author: {
    '@type': 'Organization',
    name: 'L2Titan',
    url: absoluteUrl('/'),
  },
  publisher: {
    '@type': 'Organization',
    name: 'L2Titan',
    logo: {
      '@type': 'ImageObject',
      url: absoluteUrl('/favicon.svg'),
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
};

const breadcrumbLd = buildBreadcrumb([
  { name: tk('navbar.home', 'Inicio'), path: '/' },
  { name: tk('navbar.news', 'Noticias'), path: '/news' },
  { name: resolvedTitle, path: `/news/${newsItem.slug}` },
]);
---

<Layout
  title={resolvedTitle}
  description={resolvedSummary}
  canonicalPath={`/news/${newsItem.slug}`}
  ogImage={newsItem.image}
  ogType="article"
  articlePublishedTime={newsItem.publishedAt}
  structuredData={[breadcrumbLd, articleLd]}
  preloadLcpImage={newsItem.imageCard ?? newsItem.image}
  preloadLcpImageSrcset={newsItem.imageCard && articleWebpSrcset ? articleWebpSrcset : undefined}
  preloadLcpImageSizes="(max-width: 768px) 100vw, min(896px, 100vw)"
>
  <div class="container mx-auto max-w-4xl px-4 py-12 md:py-16">
    <a href="/news" class="df-link-back mb-8 group">
      <svg
        class="h-5 w-5 transition-transform group-hover:-translate-x-1"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span data-i18n="news.articleBackToNews">{tk('news.articleBackToNews', '')}</span>
    </a>

    <article>
      <header class="mb-8">
        <time datetime={newsItem.publishedAt} class="df-kicker mb-4 block">
          {newsItem.dateLabel}
        </time>
        <h1 class="df-article-title">
          {newsItem.titleKey ? <span data-i18n={newsItem.titleKey}>{resolvedTitle}</span> : resolvedTitle}
        </h1>
      </header>

      <CardSurface className="mb-8 overflow-hidden p-0">
        {newsItem.imageCard && articleWebpSrcset ? (
          <img
            src={newsItem.imageCard}
            srcset={articleWebpSrcset}
            sizes="(max-width: 768px) 100vw, min(896px, 100vw)"
            alt={`${resolvedTitle} - L2Titan Lineage 2 Interlude`}
            width="900"
            height="540"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-48 w-full object-cover sm:h-72 md:h-96"
          />
        ) : (
          <img
            src={newsItem.image}
            alt={`${resolvedTitle} - L2Titan Lineage 2 Interlude`}
            width="896"
            height="384"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="h-48 w-full object-cover sm:h-72 md:h-96"
          />
        )}
      </CardSurface>

      <div class="df-prose space-y-4">
        <p>
          {newsItem.contentKey ? <span data-i18n={newsItem.contentKey}>{resolvedContent}</span> : resolvedContent}
        </p>
      </div>

      <footer class="df-divider mt-12 pt-8">
        <h2 class="df-section-label mb-4 text-lg uppercase tracking-wider" data-i18n="news.articleContinueReading">
          {tk('news.articleContinueReading', '')}
        </h2>
        <ul class="mb-6 list-none space-y-2 p-0 text-gray-300">
          <li>
            <a href="/downloads" class="text-yellow-400 hover:text-yellow-300 font-medium" data-i18n="news.articleLinkDownloads">
              {tk('news.articleLinkDownloads', '')}
            </a>
          </li>
          <li>
            <a href="/features" class="text-yellow-400 hover:text-yellow-300 font-medium" data-i18n="news.articleLinkFeatures">
              {tk('news.articleLinkFeatures', '')}
            </a>
          </li>
          <li>
            <a href="/faq" class="text-yellow-400 hover:text-yellow-300 font-medium" data-i18n="news.articleLinkFaq">
              {tk('news.articleLinkFaq', '')}
            </a>
          </li>
          <li>
            <a href="/info" class="text-yellow-400 hover:text-yellow-300 font-medium" data-i18n="news.articleLinkWiki">
              {tk('news.articleLinkWiki', '')}
            </a>
          </li>
        </ul>
        <ActionButton href="/downloads" variant="primary" className="px-6 py-3 text-black" data-i18n="news.articleCtaDownload">
          {tk('news.articleCtaDownload', '')}
        </ActionButton>
      </footer>
    </article>
  </div>
</Layout>

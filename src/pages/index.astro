---
import { getImage, Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ServerStats from "../components/ServerStats.astro";
import FeatureCard from "../components/FeatureCard.astro";
import NewsFeed from "../components/NewsFeed.astro";
import ActionButton from "../components/ui/ActionButton.astro";
import CardSurface from "../components/ui/CardSurface.astro";
import SectionHeading from "../components/ui/SectionHeading.astro";
import {
	buildBreadcrumb,
	buildFaq,
	buildOrganizationSchema,
	buildVideoGameSchema,
	buildWebsiteSchema,
} from "../utils/seo";
import { visitorLangFromPath } from "../utils/i18n-lang";
import { translate } from "../utils/translations";
import heroBackground from "../assets/hero-background.jpg";

const lang = visitorLangFromPath(Astro.url.pathname);

/** Variantes hero: 1440w encaja viewport ~1350px (Lighthouse desktop) sin forzar 1920w */
const HERO_WIDTHS = [480, 640, 960, 1280, 1440, 1920] as const;
const HERO_QUALITY = 70;
const heroVariants = await Promise.all(
	HERO_WIDTHS.map((w) =>
		getImage({
			src: heroBackground,
			width: w,
			format: "webp",
			quality: HERO_QUALITY,
		}),
	),
);
const heroPreloadSrcset = heroVariants
	.map((img, i) => `${img.src} ${HERO_WIDTHS[i]}w`)
	.join(", ");
const heroPreloadHref = heroVariants[0].src;

// Variable para mostrar/ocultar información del servidor
const showServerInfo = false;

const overviewItems = [
	['substackTitle', 'substackDesc'],
	['autofarmTitle', 'autofarmDesc'],
	['eventsTitle', 'eventsDesc'],
	['dailyTitle', 'dailyDesc'],
	['rankingTitle', 'rankingDesc'],
	['balanceTitle', 'balanceDesc'],
];

const quickNavLinks = [
	{ href: '/downloads', labelKey: 'home.quickNav.downloads', fallback: 'Descargar cliente' },
	{ href: '/features', labelKey: 'home.quickNav.features', fallback: 'Features del servidor' },
	{ href: '/rates', labelKey: 'home.quickNav.rates', fallback: 'Rates x25' },
	{ href: '/faq', labelKey: 'home.quickNav.faq', fallback: 'FAQ' },
	{ href: '/news', labelKey: 'home.quickNav.news', fallback: 'Noticias' },
	{ href: '/comunidad', labelKey: 'home.quickNav.community', fallback: 'Comunidad' },
] as const;

const structuredData = [
	buildWebsiteSchema(),
	buildOrganizationSchema(),
	buildVideoGameSchema(),
	buildBreadcrumb([{ name: 'Inicio', path: '/' }]),
	buildFaq([
		{
			question: '¿Qué tipo de servidor es L2Titan?',
			answer:
				'L2Titan es un servidor privado de Lineage II Interlude x25 con SubStack, AutoFarm configurable, daily instances y eventos PvP. La información detallada está en /features, /rates y /faq.',
		},
		{
			question: '¿Tiene Auto Create Account?',
			answer:
				'Sí. No hace falta registro web: la cuenta se crea al primer login. Pasos en /registro y cliente en /downloads.',
		},
		{
			question: '¿Dónde sigo parches y novedades?',
			answer: 'En /news y en el Discord oficial; la web mantiene landings por tema (economía, instancias, eventos) para enlazar con contexto.',
		},
	]),
];
---

<Layout
	title="Servidor Lineage 2 Interlude x25 con SubStack y AutoFarm"
	description="L2Titan: servidor privado Lineage II Interlude x25 con SubStack, AutoFarm, instancias diarias, TvT y economía documentada. Comunidad hispanohablante; cuenta al primer login sin formulario web."
	keywords="lineage 2 interlude server, l2 interlude server, lineage 2 private server, l2 pvp server, lineage 2 autofarm server, lineage ii interlude, l2 substack, l2 titan"
	canonicalPath="/"
	structuredData={structuredData}
	preloadLcpImage={heroPreloadHref}
	preloadLcpImageSrcset={heroPreloadSrcset}
	preloadLcpImageSizes="100vw"
>
	<section class="relative min-h-screen flex flex-col justify-center overflow-hidden">
		<div class="absolute inset-0 z-0">
			<Image
				src={heroBackground}
				alt="Cabecera visual de L2Titan, servidor Lineage 2 Interlude"
				width={1920}
				height={1080}
				sizes="100vw"
				widths={[480, 640, 960, 1280, 1440, 1920]}
				quality={HERO_QUALITY}
				format="webp"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				class="w-full h-full object-cover opacity-70"
			/>
			<div class="absolute inset-0 bg-linear-to-b from-black/45 via-black/20 to-black/75"></div>
		</div>

		<div class="relative z-30 container mx-auto px-4 mt-20">
			<div class="mx-auto max-w-6xl df-surface-strong p-6 md:p-10">
				<div class="grid lg:grid-cols-[1.25fr_1fr] gap-6 lg:gap-10 items-center">
					<div class="text-center lg:text-left">
						<h1 class="text-4xl sm:text-6xl md:text-7xl font-extrabold text-yellow-400 mb-3 drop-shadow-[0_3px_4px_rgba(0,0,0,0.7)] font-display tracking-widest">
							<span class="block">L2TITAN</span>
							<span class="mt-2 block text-base sm:text-lg md:text-xl font-semibold text-yellow-200/95 normal-case tracking-normal max-w-xl mx-auto lg:mx-0 font-sans leading-snug">
								Servidor Lineage 2 Interlude x25 — SubStack, AutoFarm y PvP
							</span>
						</h1>
						<p class="text-lg sm:text-xl md:text-2xl text-yellow-300/95 font-semibold mb-3 font-sans max-w-xl mx-auto lg:mx-0" data-i18n="home.heroPromo.title">
							Para clanes que quieren progreso real
						</p>
						<p class="text-sm md:text-base text-gray-300 max-w-xl mx-auto lg:mx-0 leading-relaxed" data-i18n="home.heroPromo.desc">
							SubStack, AutoFarm, eventos y economía activa en un servidor pensado para durar. Entra con toda la información clara desde el día uno.
						</p>
					</div>

					<div class="space-y-4 lg:pl-2">
						<ActionButton
							href="/downloads"
							variant="primary"
							className="w-full px-7 py-4 rounded-lg text-base"
						>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
							<span class="uppercase tracking-wider" data-i18n="home.downloadClient">Descargar Cliente</span>
						</ActionButton>
						<p class="px-1 pt-1 text-center lg:text-left">
							<a
								href="/registro"
								class="text-sm sm:text-[0.95rem] font-medium text-gray-300 transition-colors hover:text-yellow-200/95 focus:outline-none focus-visible:text-yellow-200 focus-visible:underline focus-visible:underline-offset-2"
								data-i18n="home.heroPromo.registroCta"
							>
								{translate('home.heroPromo.registroCta', lang, 'Sin registro web: cómo crear cuenta al primer login')}
							</a>
						</p>
						<div class="grid grid-cols-1 gap-3">
							<ActionButton
								href="https://discord.gg/GunamUdGaQ"
								target="_blank"
								rel="noopener noreferrer"
								variant="discord"
								className="w-full px-6 py-3 rounded-lg text-sm"
							>
								<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.5328-9.748-2.312-13.7083a.0765.0765 0 00-.0303-.0277zM6.4544 14.7698c-1.1985 0-2.152-1.1006-2.152-2.451 0-1.3504.9355-2.451 2.152-2.451 1.2238 0 2.1718 1.1006 2.152 2.451 0 1.3504-.9281 2.451-2.152 2.451zm6.585 0c-1.1985 0-2.152-1.1006-2.152-2.451 0-1.3504.9354-2.451 2.152-2.451 1.2238 0 2.1718 1.1006 2.152 2.451 0 1.3504-.928 2.451-2.152 2.451z"></path></svg>
								<span class="uppercase tracking-wider" data-i18n="home.joinDiscord">Unirse a Discord</span>
							</ActionButton>
						</div>
						<ActionButton
							href="/info"
							variant="ghost"
							className="w-full px-8 py-4 md:py-[1.15rem] rounded-xl border border-yellow-500/35 text-base md:text-lg hover:border-yellow-500/55 transition-colors"
						>
							<span class="font-extrabold uppercase tracking-[0.16em]" data-i18n="home.heroPromo.cta">Ver Info completa</span>
							<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
						</ActionButton>
					</div>
				</div>

			</div>
		</div>
	</section>

	{showServerInfo && <ServerStats />}

	<div class="container mx-auto px-4 py-14 md:py-18 space-y-10 md:space-y-14">
		<section class="relative z-10 mt-0" aria-labelledby="home-features-heading">
			<h2
				id="home-features-heading"
				class="sr-only"
				data-i18n="home.featuresSection.title"
			>
				{translate('home.featuresSection.title', lang, 'Destacados del servidor')}
			</h2>
			<div class="grid md:grid-cols-3 gap-5 md:gap-6">
				<FeatureCard
					title="SubStack real"
					titleKey="home.features.cumulative.title"
					description="Subclases acumulativas para armar builds mas flexibles y competitivas."
					descriptionKey="home.features.cumulative.description"
					icon="⚔️"
				/>
				<FeatureCard
					title="AutoFarm configurable"
					titleKey="home.features.events.title"
					description="Modos, assist, filtros y radio para farmear con control total."
					descriptionKey="home.features.events.description"
					icon="⚙️"
				/>
				<FeatureCard
					title="Economía y progreso"
					titleKey="home.features.economy.title"
					description="Monedas, Titan Box y tiendas con un circuito claro entre farm, PvP y bosses."
					descriptionKey="home.features.economy.description"
					icon="💰"
				/>
			</div>
		</section>

		<NewsFeed />

		<section id="server-info" class="max-w-6xl mx-auto scroll-mt-24">
			<div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
				<SectionHeading text="INFORMACIÓN DEL SERVIDOR" i18nKey="info.title" className="text-left md:text-3xl" />
			</div>

			<div class="space-y-5">
				<CardSurface className="p-6 md:p-7">
					<h3 class="text-2xl md:text-3xl font-bold text-yellow-400 mb-3 font-display" data-i18n="info.overview.title">
						L2Titan Interlude x25 - Info clara, parche activo
					</h3>
					<p class="text-gray-300 text-sm md:text-base" data-i18n="info.overview.intro1">
						Interlude x25 sobre base L2JFrozen para avanzar rapido sin perder estrategia.
					</p>
					<p class="text-gray-400 text-sm md:text-base mt-2" data-i18n="info.overview.intro2">
						Sistemas utiles dentro del juego para farmear mejor, organizarte y competir sin vueltas.
					</p>
				</CardSurface>

				<div>
					<h3 class="text-xl md:text-2xl font-bold text-yellow-500 mb-4 font-display tracking-tight" data-i18n="info.overview.sectionTitle">
						Lo mas importante para jugar mejor
					</h3>
					<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
						{overviewItems.map(([titleKey, descKey], idx) => (
							<article class="df-surface p-4 hover:border-yellow-500/30 transition-colors">
								<div class="flex items-center gap-2 mb-1">
									<span class="inline-flex h-6 min-w-6 items-center justify-center px-1 rounded-full bg-yellow-500/15 text-yellow-400 text-xs font-bold">{idx + 1}</span>
									<h4 class="text-yellow-400 font-semibold text-sm md:text-base" data-i18n={`info.overview.${titleKey}`}>{translate(`info.overview.${titleKey}`, lang, titleKey)}</h4>
								</div>
								<p class="text-gray-400 text-sm leading-relaxed" data-i18n={`info.overview.${descKey}`}>{translate(`info.overview.${descKey}`, lang, descKey)}</p>
							</article>
						))}
					</div>
					<CardSurface
						variant="strong"
						className="mt-6 p-6 md:p-8 shadow-[0_0_30px_rgba(0,0,0,0.5)] hover:border-yellow-500/35 transition-colors"
					>
						<div class="grid gap-8 lg:grid-cols-2 lg:gap-10 lg:items-start">
							<div>
								<p
									class="text-[11px] uppercase tracking-[0.28em] text-yellow-400/80 mb-2"
									data-i18n="home.guidesDeepLink.kicker"
								>
									{translate('home.guidesDeepLink.kicker', lang, 'Documentación')}
								</p>
								<h3
									class="text-xl md:text-2xl font-bold text-yellow-400 font-display tracking-wide mb-3"
									data-i18n="home.guidesDeepLink.headline"
								>
									{translate('home.guidesDeepLink.headline', lang, 'Centro de información')}
								</h3>
								<p class="text-gray-400 text-sm md:text-base leading-relaxed mb-6 max-w-xl" data-i18n="home.guidesDeepLink.hint">
									{translate(
										'home.guidesDeepLink.hint',
										lang,
										'Índice en /info: rates, features, economía, comandos e instancias. Cada tema tiene landing con URL propia para compartir.',
									)}
								</p>
								<a
									href="/info"
									class="group flex flex-col gap-2 rounded-xl border border-white/10 bg-slate-900/40 p-4 md:flex-row md:items-center md:justify-between md:gap-4 md:p-5 transition-colors hover:border-yellow-500/30 hover:bg-yellow-500/5"
								>
									<div class="min-w-0">
										<p class="font-display text-base font-bold text-white md:text-lg" data-i18n="home.guidesDeepLink.cta">
											{translate('home.guidesDeepLink.cta', lang, 'Wiki del servidor')}
										</p>
										<p class="mt-1 text-xs text-gray-400 md:text-sm leading-relaxed" data-i18n="home.guidesDeepLink.linkSub">
											{translate(
												'home.guidesDeepLink.linkSub',
												lang,
												'Todo el índice y las landings por sección en un solo lugar.',
											)}
										</p>
									</div>
									<span
										class="inline-flex shrink-0 items-center gap-2 text-sm font-bold uppercase tracking-wider text-yellow-400 font-display"
									>
										<span data-i18n="home.guidesDeepLink.action">{translate('home.guidesDeepLink.action', lang, 'Ir al índice')}</span>
										<svg
											class="h-4 w-4 transition-transform group-hover:translate-x-1"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
											aria-hidden="true"
										>
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
										</svg>
									</span>
								</a>
							</div>

							<div
								class="pt-8 mt-2 border-t border-yellow-500/25 lg:mt-0 lg:pt-0 lg:border-t-0 lg:border-l lg:border-yellow-500/30 lg:pl-10"
							>
								<p
									class="text-[11px] uppercase tracking-[0.28em] text-yellow-400/85 mb-3 font-display drop-shadow-[0_0_12px_rgba(250,204,21,0.12)]"
									data-i18n="home.quickNav.title"
								>
									{translate('home.quickNav.title', lang, 'Accesos rápidos')}
								</p>
								<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-2" role="list">
									{quickNavLinks.map((link) => (
										<li class="min-w-0">
											<a
												href={link.href}
												class="flex min-h-12 items-center justify-center rounded-xl border border-yellow-500/35 bg-slate-950/50 px-3 py-2.5 text-center text-xs font-semibold leading-snug text-yellow-100 font-display shadow-[inset_0_1px_0_0_rgba(250,204,21,0.08)] transition-colors hover:border-yellow-400/60 hover:bg-yellow-500/10 hover:text-yellow-50 sm:text-sm"
												data-i18n={link.labelKey}
											>
												{translate(link.labelKey, lang, link.fallback)}
											</a>
										</li>
									))}
								</ul>
							</div>
						</div>
					</CardSurface>
				</div>

				<CardSurface className="p-6 md:p-7">
					<h3 class="text-xl font-bold text-yellow-500 mb-3 font-display" data-i18n="info.overview.whyTitle">Por que jugar aqui</h3>
					<ul class="space-y-2 text-sm text-gray-300">
						{['whyClarity', 'whyCommands', 'whyUpdates'].map((key) => (
							<li class="flex items-start gap-2">
								<span class="text-yellow-500 mt-0.5">•</span>
								<span data-i18n={`info.overview.${key}`}>{translate(`info.overview.${key}`, lang, key)}</span>
							</li>
						))}
					</ul>
					<div class="mt-6 border-t border-white/10 pt-5 space-y-4">
						<p class="text-sm leading-relaxed text-gray-300">
							<strong class="font-semibold text-white" data-i18n="info.overview.ctaTitle">Listo para entrar?</strong>
							{' '}
							<span class="text-gray-400" data-i18n="info.overview.ctaDesc">
								Unite al Discord para novedades y soporte. Descarga el cliente y empeza hoy.
							</span>
						</p>
						<p class="text-sm flex flex-wrap gap-x-5 gap-y-1">
							<a
								href="https://discord.gg/GunamUdGaQ"
								target="_blank"
								rel="noopener noreferrer"
								class="text-yellow-500/90 hover:text-yellow-400 font-medium underline underline-offset-2"
								data-i18n="home.joinDiscord"
							>
								Unirse a Discord
							</a>
							<a
								href="/downloads"
								class="text-gray-400 hover:text-gray-200 underline underline-offset-2"
								data-i18n="navbar.downloads"
							>
								Descargas
							</a>
						</p>
						<ActionButton href="/info" variant="primary" className="px-4 py-2.5 text-black border-yellow-300/40 w-full sm:w-auto">
							Explorar centro de informacion
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
						</ActionButton>
					</div>
				</CardSurface>
			</div>
		</section>
	</div>

</Layout>

---
import Layout from '../layouts/Layout.astro';
import CardSurface from '../components/ui/CardSurface.astro';
import ActionButton from '../components/ui/ActionButton.astro';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { translate } from '../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);
const pageTitle = `404 — ${translate('error.notFoundTitle', lang, 'Page not found')}`;
---

<Layout title={pageTitle} noindex={true}>
	<div class="container mx-auto flex min-h-[70vh] items-center justify-center px-4 py-16">
		<CardSurface variant="strong" className="max-w-lg w-full p-8 md:p-10 text-center">
			<p class="df-hero-title text-7xl md:text-8xl mb-2" aria-hidden="true">404</p>
			<h1 class="text-2xl md:text-3xl font-bold text-white font-display mb-3" data-i18n="error.notFoundTitle">
				Página no encontrada
			</h1>
			<p class="df-muted mb-8" data-i18n="error.notFoundDescription">
				La página que buscas no existe o ha sido movida.
			</p>
			<ActionButton href="/" variant="primary" className="px-8 py-3 text-black" data-i18n="error.backHome">
				{translate('error.backHome', lang, 'Volver al inicio')}
			</ActionButton>
		</CardSurface>
	</div>
</Layout>

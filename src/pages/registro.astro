---
import Layout from '../layouts/Layout.astro';
import CardSurface from '../components/ui/CardSurface.astro';
import HeroBanner from '../components/ui/HeroBanner.astro';
import ActionButton from '../components/ui/ActionButton.astro';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { translate } from '../utils/translations';
import { buildBreadcrumb, buildFaq } from '../utils/seo';

const lang = visitorLangFromPath(Astro.url.pathname);
const tk = (key: string, fb: string) => translate(key, lang, fb);
const p = 'pages.register';

const structuredData = [
	buildBreadcrumb([
		{ name: tk('navbar.home', 'Inicio'), path: '/' },
		{ name: tk(`${p}.breadcrumb`, 'Crear cuenta'), path: '/registro' },
	]),
	buildFaq([
		{ question: tk(`${p}.faq1q`, ''), answer: tk(`${p}.faq1a`, '') },
		{ question: tk(`${p}.faq2q`, ''), answer: tk(`${p}.faq2a`, '') },
		{ question: tk(`${p}.faq3q`, ''), answer: tk(`${p}.faq3a`, '') },
	]),
];
---

<Layout
	title={tk(`${p}.metaTitle`, '')}
	description={tk(`${p}.metaDescription`, '')}
	keywords={tk(`${p}.metaKeywords`, '')}
	canonicalPath="/registro"
	structuredData={structuredData}
>
	<div class="container mx-auto px-4 py-12 md:py-20 max-w-4xl">
		<HeroBanner
			className="mb-8"
			kicker={tk(`${p}.kicker`, '')}
			kickerKey={`${p}.kicker`}
			title={tk(`${p}.h1`, '')}
			titleKey={`${p}.h1`}
			intro=""
		>
			<p slot="intro" class="df-lead">
				<span data-i18n={`${p}.introBefore`}>{tk(`${p}.introBefore`, '')}</span>
				<strong class="text-yellow-200" data-i18n={`${p}.introStrong`}>{tk(`${p}.introStrong`, '')}</strong>
				<span data-i18n={`${p}.introAfter`}>{tk(`${p}.introAfter`, '')}</span>
			</p>
			<ActionButton slot="actions" href="/downloads" variant="primary" className="px-5 py-3 text-black" data-i18n={`${p}.ctaDownloads`}>
				{tk(`${p}.ctaDownloads`, '')}
			</ActionButton>
			<ActionButton
				slot="actions"
				href="https://discord.gg/GunamUdGaQ"
				target="_blank"
				rel="noopener noreferrer"
				variant="discord"
				className="px-5 py-3"
				data-i18n={`${p}.ctaDiscord`}
			>
				{tk(`${p}.ctaDiscord`, '')}
			</ActionButton>
			<nav slot="footer" class="mt-4 text-sm">
				<a href="/faq" class="text-yellow-400 hover:text-yellow-300" data-i18n={`${p}.ctaFaq`}>
					{tk(`${p}.ctaFaq`, '')}
				</a>
			</nav>
		</HeroBanner>

		<section aria-labelledby="registro-pasos" class="mb-10">
			<CardSurface className="p-6 md:p-8">
				<h2 id="registro-pasos" class="df-section-label mb-4" data-i18n={`${p}.stepsTitle`}>
					{tk(`${p}.stepsTitle`, '')}
				</h2>
				<ol class="space-y-4">
					<li class="flex items-start gap-4">
						<span class="df-step-num">1</span>
						<p class="pt-0.5 text-sm md:text-base text-gray-300">
							<span data-i18n={`${p}.step1Before`}>{tk(`${p}.step1Before`, '')}</span>
							<a href="/downloads" class="text-yellow-400 hover:text-yellow-300 underline underline-offset-2" data-i18n={`${p}.step1Link`}>
								{tk(`${p}.step1Link`, '')}
							</a>
							<span data-i18n={`${p}.step1After`}>{tk(`${p}.step1After`, '')}</span>
						</p>
					</li>
					<li class="flex items-start gap-4">
						<span class="df-step-num">2</span>
						<p class="pt-0.5 text-sm md:text-base text-gray-300" data-i18n={`${p}.step2`}>{tk(`${p}.step2`, '')}</p>
					</li>
					<li class="flex items-start gap-4">
						<span class="df-step-num">3</span>
						<p class="pt-0.5 text-sm md:text-base text-gray-300" data-i18n={`${p}.step3`}>{tk(`${p}.step3`, '')}</p>
					</li>
					<li class="flex items-start gap-4">
						<span class="df-step-num">4</span>
						<p class="pt-0.5 text-sm md:text-base text-gray-300" data-i18n={`${p}.step4`}>{tk(`${p}.step4`, '')}</p>
					</li>
				</ol>
			</CardSurface>
		</section>

		<section aria-labelledby="registro-seguridad" class="mb-10">
			<h2 id="registro-seguridad" class="text-2xl font-bold text-yellow-400 font-display mb-4" data-i18n={`${p}.securityTitle`}>
				{tk(`${p}.securityTitle`, '')}
			</h2>
			<p class="text-gray-300 text-sm md:text-base leading-relaxed" data-i18n={`${p}.securityBody`}>{tk(`${p}.securityBody`, '')}</p>
		</section>

		<nav
			class="df-surface-strong p-5 rounded-xl border border-white/10 text-sm"
			aria-label={tk(`${p}.moreNavAria`, '')}
			data-i18n-aria-label={`${p}.moreNavAria`}
		>
			<p class="text-gray-400 mb-3" data-i18n={`${p}.moreLabel`}>{tk(`${p}.moreLabel`, '')}</p>
			<ul class="space-y-2 text-yellow-400">
				<li>
					<a href="/rates" class="hover:text-yellow-300" data-i18n={`${p}.moreRates`}>{tk(`${p}.moreRates`, '')}</a>
				</li>
				<li>
					<a href="/features" class="hover:text-yellow-300" data-i18n={`${p}.moreFeatures`}>{tk(`${p}.moreFeatures`, '')}</a>
				</li>
				<li>
					<a href="/comunidad" class="hover:text-yellow-300" data-i18n={`${p}.moreCommunity`}>{tk(`${p}.moreCommunity`, '')}</a>
				</li>
			</ul>
		</nav>
	</div>
</Layout>

---
import InfoLandingLayout from '../layouts/InfoLandingLayout.astro';
import TabSieges from '../components/info/TabSieges.astro';
import { infoLandingConfigs } from '../data/infoLandingConfigs';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { buildLocalizedInfoTopicBreadcrumb, buildLandingTopicFaq } from '../utils/seo';

const lang = visitorLangFromPath(Astro.url.pathname);
const config = infoLandingConfigs.sieges;
const structuredData = [
  buildLocalizedInfoTopicBreadcrumb(lang, config.topicSlug, config.heading, config.canonicalPath),
  buildLandingTopicFaq(lang, config.topicSlug),
].filter(Boolean);
---

<InfoLandingLayout {...config} structuredData={structuredData}>
  <TabSieges />
</InfoLandingLayout>

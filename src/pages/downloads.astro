---
import Layout from '../layouts/Layout.astro';
import ActionButton from '../components/ui/ActionButton.astro';
import CardSurface from '../components/ui/CardSurface.astro';
import RelatedDocsSection from '../components/ui/RelatedDocsSection.astro';
import RequirementCard from '../components/ui/RequirementCard.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import StepList from '../components/ui/StepList.astro';
import {
  buildBreadcrumb,
  buildFaq,
  buildSoftwareApplicationSchema,
} from '../utils/seo';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { translate } from '../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);
const rd = (key: string, fb: string) => translate(`downloads.relatedDocs.${key}`, lang, fb);

const relatedDocLinks = [
	{ href: '/features', i18nKey: 'features', fallback: 'Features del servidor' },
	{ href: '/rates', i18nKey: 'rates', fallback: 'Rates x25' },
	{ href: '/comunidad', i18nKey: 'community', fallback: 'Discord y comunidad' },
	{ href: '/news', i18nKey: 'news', fallback: 'Noticias' },
] as const;

const relatedDocNavLinks = relatedDocLinks.map((link) => ({
	href: link.href,
	label: translate(`downloads.relatedDocs.${link.i18nKey}`, lang, link.fallback),
	labelKey: `downloads.relatedDocs.${link.i18nKey}`,
}));

const quickStartSteps = [
	{ n: 1, text: translate('downloads.quickStart.step1', lang, ''), i18nKey: 'downloads.quickStart.step1' },
	{ n: 2, text: translate('downloads.quickStart.step2', lang, ''), i18nKey: 'downloads.quickStart.step2' },
	{ n: 3, text: translate('downloads.quickStart.step3', lang, ''), i18nKey: 'downloads.quickStart.step3' },
	{ n: 4, text: translate('downloads.quickStart.step4', lang, ''), i18nKey: 'downloads.quickStart.step4' },
];

const downloads = [
  {
    name: 'Cliente Completo',
    nameKey: 'downloads.fileNames.fullClient',
    size: '2.8 GB',
    link: 'https://drive.google.com/file/d/12kuIp38V9BqX4MfRVMA_Kq7S5_MCIAp0/view?usp=sharing',
    type: 'Google Drive',
    icon: {
      class: 'w-6 h-6 text-yellow-500',
      path: 'M7.71 3.5L1.15 15l3.42 5.91L12 15l-4.29-7.5L7.71 3.5M12 15l3.42 5.91L22.85 15l-3.42-5.91L12 15m0 0L8.58 9.09 12 3.5l3.42 5.59L12 15z',
      fill: true,
    },
  },
  {
    name: 'Cliente Completo',
    nameKey: 'downloads.fileNames.fullClient',
    size: '2.8 GB',
    link: 'https://mega.nz/file/WfZjGTZb#n2P6GBrTGMmiAin6tM6SRPCEtEfe4q4jCFB3NVYbuY4',
    type: 'Mega',
    icon: {
      class: 'w-6 h-6 text-yellow-500',
      path: 'M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm6.895 8.104l-6.895 6.895-6.895-6.895L12 5.21l6.895 2.894z',
      fill: true,
    },
  },
  {
    name: 'Cliente Completo',
    nameKey: 'downloads.fileNames.fullClient',
    size: '2.8 GB',
    link: 'https://downloads.l2-titan.com/zip/Lineage2.zip',
    type: 'Direct',
    filename: 'Lineage2.zip',
    icon: {
      class: 'w-6 h-6 text-yellow-500',
      path: 'M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4',
      fill: false,
    },
  },
  {
    name: 'Launcher',
    nameKey: 'downloads.fileNames.launcher',
    size: '74 MB',
    link: 'https://downloads.l2-titan.com/zip/L2TitanLauncher.zip',
    type: 'Direct',
    filename: 'L2TitanLauncher.exe',
    icon: {
      class: 'w-6 h-6 text-yellow-500',
      path: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
      fill: false,
    },
  },
];

const isDirectDownload = (type: string) => type === 'Direct';

const getDownloadFilename = (file: typeof downloads[0]) => {
  if (file.filename) return file.filename;
  const url = new URL(file.link);
  const pathname = url.pathname;
  const filename = pathname.split('/').pop() || '';
  return filename || `${file.name.replace(/\s+/g, '')}.${file.link.match(/\.(\w+)$/)?.[1] || 'exe'}`;
};

const structuredData = [
  buildBreadcrumb([
    { name: 'Inicio', path: '/' },
    { name: 'Descargas', path: '/downloads' },
  ]),
  buildSoftwareApplicationSchema(),
  buildFaq([
    {
      question: 'Como descargar Lineage 2 Interlude para jugar en L2Titan?',
      answer: 'Puedes bajar el cliente completo o el launcher oficial desde Google Drive, Mega o descarga directa en esta misma página.',
    },
    {
      question: 'Necesito registrarme antes de entrar al servidor?',
      answer: 'No. L2Titan usa Auto Create Account, asi que tu cuenta se crea automaticamente al primer login dentro del juego.',
    },
    {
      question: 'Que requisitos necesita el cliente de L2Titan?',
      answer: 'La página muestra requisitos minimos y recomendados para Windows, CPU, RAM, GPU y espacio libre antes de descargar.',
    },
  ]),
];
---

<Layout
  title="Descargar cliente Lineage 2 Interlude — L2Titan"
  description="Cliente completo y launcher oficial de L2Titan para Windows: espejos Drive, Mega y descarga directa, requisitos y Auto Create Account al primer login."
  keywords="descargar lineage 2 interlude, l2 interlude client download, l2 titan download, lineage 2 interlude launcher, l2 private server client"
  canonicalPath="/downloads"
  structuredData={structuredData}
>
  <div class="container mx-auto px-4 py-12 md:py-24">
    <SectionHeading text="CENTRO DE DESCARGAS" i18nKey="downloads.title" className="mb-6 md:mb-8" as="h1" />

    <CardSurface className="max-w-5xl mx-auto mb-8 md:mb-10 df-notice-success p-5 md:p-6">
      <div class="flex items-start gap-3">
        <span class="text-2xl leading-none" aria-hidden="true">&#x2705;</span>
        <div>
          <h2 class="df-section-label mb-1 text-emerald-300" data-i18n="downloads.accountNotice.title">
            Auto Create Account activado
          </h2>
          <p class="df-muted text-emerald-100/90" data-i18n="downloads.accountNotice.description">
            No necesitas registrarte en una web. Tu cuenta se crea automaticamente cuando entras al juego por primera vez.
          </p>
        </div>
      </div>
    </CardSurface>

    <div class="hidden md:block max-w-5xl mx-auto df-table-wrap mb-16 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
        <table class="w-full text-left">
          <thead>
            <tr>
              <th data-i18n="downloads.table.file">Archivo</th>
              <th data-i18n="downloads.table.size">Tamaño</th>
              <th data-i18n="downloads.table.type">Tipo</th>
              <th class="text-right" data-i18n="downloads.table.action">Acción</th>
            </tr>
          </thead>
          <tbody>
            {downloads.map((file) => (
              <tr class="hover:bg-yellow-500/5 transition-colors group">
                <td class="font-medium text-white group-hover:text-yellow-200 transition-colors">
                  <span class="inline-flex items-center gap-3">
                  {file.icon.fill ? (
                    <svg class={file.icon.class} fill="currentColor" viewBox="0 0 24 24">
                      <path d={file.icon.path} />
                    </svg>
                  ) : (
                    <svg class={file.icon.class} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={file.icon.path} />
                    </svg>
                  )}
                  {file.nameKey ? <span data-i18n={file.nameKey}>{file.name}</span> : file.name}
                  </span>
                </td>
                <td class="font-mono text-gray-400">{file.size}</td>
                <td class="text-gray-400">{file.type}</td>
                <td class="text-right">
                  <ActionButton
                    href={file.link}
                    download={isDirectDownload(file.type) ? getDownloadFilename(file) : undefined}
                    target={file.link !== '#' ? '_blank' : undefined}
                    rel={file.link !== '#' ? 'noopener noreferrer' : undefined}
                    variant="ghost"
                    className="px-6 py-2 text-sm"
                  >
                    <span data-i18n="downloads.download">Descargar</span>
                  </ActionButton>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
    </div>

    <div class="md:hidden max-w-5xl mx-auto space-y-4 mb-12">
      {downloads.map((file) => (
        <CardSurface variant="strong" className="p-5 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
          <div class="flex items-center gap-3 mb-3">
            {file.icon.fill ? (
              <svg class={file.icon.class} fill="currentColor" viewBox="0 0 24 24">
                <path d={file.icon.path} />
              </svg>
            ) : (
              <svg class={file.icon.class} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={file.icon.path} />
              </svg>
            )}
            <span class="font-medium text-white">
              {file.nameKey ? <span data-i18n={file.nameKey}>{file.name}</span> : file.name}
            </span>
          </div>
          <div class="flex items-center gap-3 mb-4">
            <span class="text-gray-400 font-mono text-sm">{file.size}</span>
            <span class="text-xs text-gray-500 bg-white/5 px-2 py-0.5 rounded">{file.type}</span>
          </div>
          <ActionButton
            href={file.link}
            download={isDirectDownload(file.type) ? getDownloadFilename(file) : undefined}
            target={file.link !== '#' ? '_blank' : undefined}
            rel={file.link !== '#' ? 'noopener noreferrer' : undefined}
            variant="ghost"
            className="w-full px-6 py-3"
          >
            <span data-i18n="downloads.download">Descargar</span>
          </ActionButton>
        </CardSurface>
      ))}
    </div>

    <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8">
      <RequirementCard
        accentLabel="MINIMOS"
        accentKey="downloads.requirements.minimum"
        titleLabel="REQUISITOS"
        titleKey="downloads.requirements.requirements"
        rows={[
          { label: 'OS:', value: 'Windows 7/8/10' },
          { label: 'CPU:', value: 'Intel Core i3' },
          { label: 'RAM:', value: '4 GB' },
          { label: 'GPU:', value: 'GeForce GT 630' },
          { label: 'HDD:', value: '30 GB libres' },
        ]}
      />
      <RequirementCard
        accentLabel="RECOMENDADOS"
        accentKey="downloads.requirements.recommended"
        titleLabel="REQUISITOS"
        titleKey="downloads.requirements.requirements"
        rows={[
          { label: 'OS:', value: 'Windows 10/11' },
          { label: 'CPU:', value: 'Intel Core i5+' },
          { label: 'RAM:', value: '8 GB+' },
          { label: 'GPU:', value: 'GeForce GTX 1050+' },
          { label: 'HDD:', value: 'SSD 30 GB' },
        ]}
      />
    </div>

    <CardSurface className="max-w-5xl mx-auto mt-8 md:mt-10 p-5 md:p-8 hover:border-yellow-500/30 transition-colors">
      <h2 class="df-section-label mb-4" data-i18n="downloads.quickStart.title">
        Pasos rápidos para jugar
      </h2>
      <StepList steps={quickStartSteps} />
    </CardSurface>

    <RelatedDocsSection
      id="downloads-más-info"
      className="mt-10 md:mt-14"
      kicker={rd('kicker', 'Después de descargar')}
      kickerKey="downloads.relatedDocs.kicker"
      title={rd('title', 'Documentación relacionada')}
      titleKey="downloads.relatedDocs.title"
      subtitle={rd(
        'subtitle',
        'Instalá el cliente y seguí con rates, features y la comunidad; todo está enlazado para que no te pierdas.',
      )}
      subtitleKey="downloads.relatedDocs.subtitle"
      wikiTitle={rd('wikiCta', 'Wiki del servidor')}
      wikiTitleKey="downloads.relatedDocs.wikiCta"
      wikiHint={rd('wikiHint', 'Índice en /info: rates, VIP, economía, comandos e instancias.')}
      wikiHintKey="downloads.relatedDocs.wikiHint"
      wikiAction={rd('wikiAction', 'Ir al índice')}
      wikiActionKey="downloads.relatedDocs.wikiAction"
      quickLinksLabel={translate('downloads.relatedDocs.quickLinksLabel', lang, 'Enlaces rápidos')}
      quickLinksLabelKey="downloads.relatedDocs.quickLinksLabel"
      navAria={rd('navAria', 'Enlaces útiles después de instalar el cliente')}
      links={relatedDocNavLinks}
    />
  </div>
</Layout>

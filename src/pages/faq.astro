---
import Layout from '../layouts/Layout.astro';
import CardSurface from '../components/ui/CardSurface.astro';
import ActionButton from '../components/ui/ActionButton.astro';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { translate } from '../utils/translations';
import { buildBreadcrumb, buildFaq } from '../utils/seo';

const lang = visitorLangFromPath(Astro.url.pathname);
const tk = (key: string, fb: string) => translate(key, lang, fb);

const faqEntries = [
	{ qKey: 'faqPage.q1', aKey: 'faqPage.a1' },
	{ qKey: 'faqPage.q2', aKey: 'faqPage.a2' },
	{ qKey: 'faqPage.q3', aKey: 'faqPage.a3' },
	{ qKey: 'faqPage.q4', aKey: 'faqPage.a4' },
	{ qKey: 'faqPage.q5', aKey: 'faqPage.a5' },
	{ qKey: 'faqPage.q6', aKey: 'faqPage.a6' },
	{ qKey: 'faqPage.q7', aKey: 'faqPage.a7' },
] as const;

const faqForSchema = faqEntries.map(({ qKey, aKey }) => ({
	question: tk(qKey, ''),
	answer: tk(aKey, ''),
}));

const structuredData = [
	buildBreadcrumb([
		{ name: tk('navbar.home', 'Inicio'), path: '/' },
		{ name: 'FAQ', path: '/faq' },
	]),
	buildFaq(faqForSchema),
];
---

<Layout
	title={tk('faqPage.metaTitle', '')}
	description={tk('faqPage.metaDescription', '')}
	keywords="l2 interlude server faq, lineage 2 interlude private server, l2 titan substack, l2 autofarm interlude, crear cuenta l2 servidor"
	canonicalPath="/faq"
	structuredData={structuredData}
>
	<div class="container mx-auto px-4 py-12 md:py-20 max-w-4xl">
		<CardSurface variant="strong" className="p-6 md:p-10 mb-10">
			<p class="text-[11px] uppercase tracking-[0.28em] text-yellow-400/80 mb-3" data-i18n="faqPage.kicker">
				{tk('faqPage.kicker', '')}
			</p>
			<h1 class="text-3xl md:text-5xl font-extrabold text-yellow-400 font-display tracking-wide mb-4" data-i18n="faqPage.title">
				{tk('faqPage.title', '')}
			</h1>
			<p class="text-gray-300 text-base md:text-lg leading-relaxed mb-6" data-i18n="faqPage.intro">
				{tk('faqPage.intro', '')}
			</p>
			<div class="flex flex-wrap gap-3">
				<ActionButton href="/downloads" variant="primary" className="px-5 py-3 text-black" data-i18n="faqPage.downloadCta">
					{tk('faqPage.downloadCta', '')}
				</ActionButton>
				<ActionButton href="/registro" variant="ghost" className="px-5 py-3" data-i18n="faqPage.accountCta">
					{tk('faqPage.accountCta', '')}
				</ActionButton>
				<ActionButton href="/features" variant="ghost" className="px-5 py-3" data-i18n="faqPage.featuresCta">
					{tk('faqPage.featuresCta', '')}
				</ActionButton>
			</div>
		</CardSurface>

		<h2 class="sr-only" data-i18n="faqPage.srHeading">{tk('faqPage.srHeading', '')}</h2>
		<div class="space-y-5">
			{
				faqEntries.map(({ qKey, aKey }) => (
					<CardSurface className="p-5 md:p-6">
						<h3 class="text-lg md:text-xl font-bold text-yellow-400 font-display mb-2" data-i18n={qKey}>
							{tk(qKey, '')}
						</h3>
						<p class="text-gray-300 text-sm md:text-base leading-relaxed" data-i18n={aKey}>
							{tk(aKey, '')}
						</p>
					</CardSurface>
				))
			}
		</div>

		<section class="mt-12 df-surface-strong p-6 md:p-8 rounded-xl border border-white/10" aria-labelledby="faq-mas">
			<h2 id="faq-mas" class="text-xl font-bold text-white font-display mb-3" data-i18n="faqPage.nextTitle">
				{tk('faqPage.nextTitle', '')}
			</h2>
			<p class="text-gray-400 text-sm mb-4" data-i18n="faqPage.nextBody">
				{tk('faqPage.nextBody', '')}
			</p>
			<nav class="flex flex-wrap gap-2 text-sm" aria-label="Enlaces relacionados">
				<a href="/news" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.linkNews">
					{tk('faqPage.linkNews', '')}
				</a>
				<span class="text-gray-600" aria-hidden="true">·</span>
				<a href="/info" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.linkWiki">
					{tk('faqPage.linkWiki', '')}
				</a>
				<span class="text-gray-600" aria-hidden="true">·</span>
				<a href="/comunidad" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.linkCommunity">
					{tk('faqPage.linkCommunity', '')}
				</a>
			</nav>
		</section>
	</div>
</Layout>

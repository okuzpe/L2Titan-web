---
import InfoLandingLayout from '../layouts/InfoLandingLayout.astro';
import TabEnchant from '../components/info/TabEnchant.astro';
import { infoLandingConfigs } from '../data/infoLandingConfigs';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { buildLocalizedInfoTopicBreadcrumb } from '../utils/seo';

const lang = visitorLangFromPath(Astro.url.pathname);
const config = infoLandingConfigs.enchant;
const structuredData = [buildLocalizedInfoTopicBreadcrumb(lang, config.topicSlug, config.heading, config.canonicalPath)];
---

<InfoLandingLayout {...config} structuredData={structuredData}>
  <TabEnchant />
</InfoLandingLayout>

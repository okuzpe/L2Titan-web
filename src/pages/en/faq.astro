---
import Layout from '../../layouts/Layout.astro';
import HeroBanner from '../../components/ui/HeroBanner.astro';
import FaqItem from '../../components/ui/FaqItem.astro';
import ActionButton from '../../components/ui/ActionButton.astro';
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { translate } from '../../utils/translations';
import { buildBreadcrumb, buildFaq } from '../../utils/seo';

const lang = visitorLangFromPath(Astro.url.pathname);
const tk = (key: string, fb: string) => translate(key, lang, fb);

const faqEntries = [
	{ qKey: 'faqPage.q1', aKey: 'faqPage.a1' },
	{ qKey: 'faqPage.q2', aKey: 'faqPage.a2' },
	{ qKey: 'faqPage.q3', aKey: 'faqPage.a3' },
	{ qKey: 'faqPage.q4', aKey: 'faqPage.a4' },
	{ qKey: 'faqPage.q5', aKey: 'faqPage.a5' },
	{ qKey: 'faqPage.q6', aKey: 'faqPage.a6' },
	{ qKey: 'faqPage.q7', aKey: 'faqPage.a7' },
] as const;

const faqForSchema = faqEntries.map(({ qKey, aKey }) => ({
	question: tk(qKey, ''),
	answer: tk(aKey, ''),
}));

const structuredData = [
	buildBreadcrumb([
		{ name: tk('navbar.home', 'Home'), path: '/' },
		{ name: tk('navbar.faq', 'FAQ'), path: '/en/faq' },
	]),
	buildFaq(faqForSchema),
];
---

<Layout
	title={tk('faqPage.metaTitle', 'FAQ — L2Titan')}
	description={tk('faqPage.metaDescription', 'Frequently asked questions about L2Titan Lineage 2 Interlude x25 private server.')}
	keywords="l2 interlude server faq, lineage 2 interlude private server, l2 titan substack, l2 autofarm interlude, l2 server account creation"
	canonicalPath="/en/faq"
	alternateLocalePath="/faq"
	structuredData={structuredData}
	htmlLang="en"
	ogLocale="en_US"
	ogLocaleAlternate="es_ES"
	defaultVisitorLang="en"
>
	<div class="container mx-auto px-4 py-12 md:py-20 max-w-4xl">
		<HeroBanner
			className="mb-10"
			kicker={tk('faqPage.kicker', '')}
			kickerKey="faqPage.kicker"
			title={tk('faqPage.title', '')}
			titleKey="faqPage.title"
			intro={tk('faqPage.intro', '')}
			introKey="faqPage.intro"
		>
			<ActionButton slot="actions" href="/downloads" variant="primary" className="px-5 py-3 text-black" data-i18n="faqPage.downloadCta">
				{tk('faqPage.downloadCta', '')}
			</ActionButton>
			<ActionButton slot="actions" href="/registro" variant="ghost" className="px-5 py-3" data-i18n="faqPage.accountCta">
				{tk('faqPage.accountCta', '')}
			</ActionButton>
			<nav slot="footer" class="mt-4 text-sm">
				<a href="/features" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.featuresCta">
					{tk('faqPage.featuresCta', '')}
				</a>
			</nav>
		</HeroBanner>

		<div class="space-y-3">
			{
				faqEntries.map(({ qKey, aKey }) => (
					<FaqItem
						question={tk(qKey, '')}
						answer={tk(aKey, '')}
						questionKey={qKey}
						answerKey={aKey}
					/>
				))
			}
		</div>

		<section class="mt-12 df-surface-strong p-6 md:p-8 rounded-xl border border-white/10" aria-labelledby="faq-more">
			<h2 id="faq-more" class="text-xl font-bold text-white font-display mb-3" data-i18n="faqPage.nextTitle">
				{tk('faqPage.nextTitle', '')}
			</h2>
			<p class="text-gray-400 text-sm mb-4" data-i18n="faqPage.nextBody">
				{tk('faqPage.nextBody', '')}
			</p>
			<nav class="flex flex-wrap gap-2 text-sm" aria-label="Related links">
				<a href="/news" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.linkNews">
					{tk('faqPage.linkNews', '')}
				</a>
				<span class="text-gray-600" aria-hidden="true">·</span>
				<a href="/info" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.linkWiki">
					{tk('faqPage.linkWiki', '')}
				</a>
				<span class="text-gray-600" aria-hidden="true">·</span>
				<a href="/comunidad" class="text-yellow-400 hover:text-yellow-300" data-i18n="faqPage.linkCommunity">
					{tk('faqPage.linkCommunity', '')}
				</a>
			</nav>
		</section>
	</div>
</Layout>

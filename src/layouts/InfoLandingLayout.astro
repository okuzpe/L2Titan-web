---
import Layout from './Layout.astro';
import ActionButton from '../components/ui/ActionButton.astro';
import CardSurface from '../components/ui/CardSurface.astro';
import HeroBanner from '../components/ui/HeroBanner.astro';
import type { InfoContentBlock, InfoLandingTopicSlug, LandingCtaPreset } from '../data/infoLandingConfigs';
import { infoWikiSections } from '../data/infoWiki';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { translate } from '../utils/translations';

interface Props {
	title: string;
	description: string;
	keywords?: string;
	canonicalPath: string;
	heading: string;
	intro: string;
	topicSlug: InfoLandingTopicSlug;
	ogImage?: string;
	structuredData?: object[];
	contentBlocks?: InfoContentBlock[];
	showBreadcrumbs?: boolean;
	landingCtaPreset?: LandingCtaPreset;
}

const {
	title,
	description,
	keywords,
	canonicalPath,
	heading,
	intro,
	topicSlug,
	ogImage,
	structuredData = [],
	contentBlocks = [],
	showBreadcrumbs = true,
	landingCtaPreset = 'default',
} = Astro.props;

const lang = visitorLangFromPath(Astro.url.pathname);
/** Landing en inglés: `canonicalPath` empieza por `/en`. Prefija enlaces internos y emite hreflang/lang EN. */
const isEn = canonicalPath === '/en' || canonicalPath.startsWith('/en/');
/** Prefija una ruta ES con `/en` cuando la landing es inglesa (enlaces internos coherentes con el idioma). */
const L = (p: string) => (isEn ? (p === '/' ? '/en' : `/en${p}`) : p);
/** Pareja hreflang: ES↔EN. La ruta canónica EN es la ES con prefijo `/en`. */
const esCanonical = isEn ? canonicalPath.replace(/^\/en/, '') || '/' : canonicalPath;
const alternateLocalePath = isEn ? esCanonical : `/en${canonicalPath}`;
const headingKey = `info.landings.topics.${topicSlug}.heading`;
const introKey = `info.landings.topics.${topicSlug}.intro`;
const metaTitleKey = `info.landings.topics.${topicSlug}.metaTitle`;
const metaDescKey = `info.landings.topics.${topicSlug}.metaDescription`;
const factOpenerKey = `info.landings.topics.${topicSlug}.factOpener`;
const headingDisplay = translate(headingKey, lang, heading);
const introDisplay = translate(introKey, lang, intro);
const titleDisplay = translate(metaTitleKey, lang, title);
const descriptionDisplay = translate(metaDescKey, lang, description);
/** Frase declarativa con los datos concretos (rates, números): texto citable por motores generativos antes de las tablas. */
const factOpenerDisplay = translate(factOpenerKey, lang, '');

const normalizedCanonical = esCanonical.replace(/^\/+|\/+$/g, '');
const wikiSectionMatch = infoWikiSections.find((s) => s.slug === normalizedCanonical);
/** Las páginas wiki detalle (`/info/<slug>`) solo existen en ES; en EN se enlaza al índice `/en/info`. */
const wikiPath = isEn ? '/en/info' : wikiSectionMatch ? `/info/${wikiSectionMatch.slug}` : '/info';

const breadcrumbItems = [
	{ name: translate('navbar.home', lang, 'Inicio'), href: L('/'), i18nKey: 'navbar.home' },
	{
		name: translate('info.landings.breadcrumbWiki', lang, 'Información'),
		href: L('/info'),
		i18nKey: 'info.landings.breadcrumbWiki',
	},
	{ name: headingDisplay, href: canonicalPath, i18nKey: headingKey },
];

type SecondaryCta = { href: string; labelKey: string; fallback: string };

let secondaryCta: SecondaryCta | null = null;
let wikiAsTextLink = false;

if (landingCtaPreset === 'economy') {
	secondaryCta = { href: '/rates', labelKey: 'info.landings.ctaRates', fallback: 'Ver rates x25' };
	wikiAsTextLink = true;
} else if (landingCtaPreset === 'rates') {
	secondaryCta = { href: '/economy', labelKey: 'info.landings.ctaEconomy', fallback: 'Ver economía y monedas' };
	wikiAsTextLink = true;
} else if (landingCtaPreset === 'events') {
	secondaryCta = { href: '/instances', labelKey: 'info.landings.ctaInstances', fallback: 'Dailies e instancias' };
	wikiAsTextLink = true;
} else if (landingCtaPreset === 'instances') {
	secondaryCta = { href: '/economy', labelKey: 'info.landings.ctaEconomy', fallback: 'Ver economía y monedas' };
	wikiAsTextLink = true;
}
// En inglés, los CTAs internos apuntan a las landings EN equivalentes.
if (secondaryCta) secondaryCta.href = L(secondaryCta.href);
---

<Layout
	title={titleDisplay}
	description={descriptionDisplay}
	keywords={keywords}
	canonicalPath={canonicalPath}
	ogImage={ogImage}
	structuredData={structuredData}
	htmlLang={isEn ? 'en' : 'es'}
	ogLocale={isEn ? 'en_US' : 'es_ES'}
	ogLocaleAlternate={isEn ? 'es_ES' : 'en_US'}
	defaultVisitorLang={isEn ? 'en' : undefined}
	alternateLocalePath={alternateLocalePath}
>
	<div class="container mx-auto px-4 py-12 md:py-20">
		{showBreadcrumbs && (
			<div class="max-w-6xl mx-auto">
				<Breadcrumbs items={breadcrumbItems} />
			</div>
		)}
		<section class="max-w-6xl mx-auto mb-10">
			<HeroBanner
				className="w-full"
				title={headingDisplay}
				titleKey={headingKey}
				intro={introDisplay}
				introKey={introKey}
			>
				<ActionButton slot="actions" href={L('/downloads')} variant="primary" className="px-5 py-3 text-black" data-i18n="home.downloadClient">
					{translate('home.downloadClient', lang, 'Descargar cliente')}
				</ActionButton>
				{
					secondaryCta && (
						<ActionButton
							slot="actions"
							href={secondaryCta.href}
							variant="ghost"
							className="px-5 py-3"
							data-i18n={secondaryCta.labelKey}
						>
							{translate(secondaryCta.labelKey, lang, secondaryCta.fallback)}
						</ActionButton>
					)
				}
				{
					wikiAsTextLink ? (
						<a
							slot="footer"
							href={wikiPath}
							class="mt-4 inline-block text-sm text-yellow-500/90 hover:text-yellow-400 underline underline-offset-2"
							data-i18n="info.landings.openInWiki"
						>
							{translate('info.landings.openInWiki', lang, 'Abrir en la wiki')}
						</a>
					) : (
						<ActionButton
							slot="actions"
							href={wikiPath}
							variant="ghost"
							className="px-5 py-3"
							data-i18n="info.landings.openInWiki"
						>
							{translate('info.landings.openInWiki', lang, 'Abrir en la wiki')}
						</ActionButton>
					)
				}
			</HeroBanner>
		</section>

		{factOpenerDisplay && (
			<section class="max-w-6xl mx-auto mb-10">
				<p
					class="df-lead text-base md:text-lg text-gray-100 border-l-2 border-yellow-500/50 pl-4"
					data-i18n={factOpenerKey}
				>
					{factOpenerDisplay}
				</p>
			</section>
		)}

		{contentBlocks.length > 0 &&
			contentBlocks.map((block, blockIndex) => (
				<section class="max-w-6xl mx-auto mb-10" aria-labelledby={`landing-block-${blockIndex}`}>
					<CardSurface variant="strong" className="w-full p-6 md:p-8">
						<h2 id={`landing-block-${blockIndex}`} class="text-2xl md:text-3xl font-bold text-yellow-400 font-display mb-4">
							{block.heading}
						</h2>
						<p class="text-gray-300 leading-relaxed text-sm md:text-base whitespace-pre-line">{block.body}</p>
					</CardSurface>
				</section>
			))}

		<div class="max-w-6xl mx-auto mb-10">
			<slot />
		</div>
	</div>
</Layout>

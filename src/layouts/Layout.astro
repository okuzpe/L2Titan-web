---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { translations } from "../data/translations";
import { DEFAULT_OG_IMAGE, SITE_URL, absoluteUrl } from "../utils/seo";
import { visitorLangFromPath } from "../utils/i18n-lang";
import { translate } from "../utils/translations";

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogType?: string;
	articlePublishedTime?: string;
	noindex?: boolean;
	canonicalPath?: string;
	robots?: string;
	structuredData?: object[];
	/** Document language for `<html lang>` and initial SEO signals */
	htmlLang?: string;
	/** Primary Open Graph locale, e.g. es_ES or en_US */
	ogLocale?: string;
	/** Alternate locale for og:locale:alternate */
	ogLocaleAlternate?: string;
	/** Force client i18n to this language on first paint (e.g. English SEO routes under `/en/`) */
	defaultVisitorLang?: "es" | "en";
	/** Canonical path of the alternate-language version of this page (used to emit hreflang pairs).
	 *  ES page sets "/en/foo", EN page sets "/foo". x-default always points to the ES version. */
	alternateLocalePath?: string;
	/** Preload a same-origin image (e.g. home hero) to improve LCP */
	preloadLcpImage?: string;
	/** `imagesrcset` para preload responsive (móvil descarga ~480–640w, no 1920w) */
	preloadLcpImageSrcset?: string;
	/** Debe coincidir con el `sizes` del `<img>` del hero (p. ej. 100vw) */
	preloadLcpImageSizes?: string;
}

const {
	title,
	description = "L2Titan Interlude x25 sobre base L2JFrozen con SubStack, AutoFarm configurable, TvT activo, instancias diarias y comandos in-game para progresar con claridad.",
	keywords = "lineage 2 private server x25, l2 interlude private server, l2 titan, l2 substack, lineage 2 cumulative subclasses, l2 interlude pvp server, l2 events tvt, l2 daily instances, l2 ranking .top",
	ogImage = DEFAULT_OG_IMAGE,
	ogType = "website",
	articlePublishedTime,
	noindex = false,
	canonicalPath,
	robots,
	structuredData = [],
	htmlLang: htmlLangProp,
	ogLocale: ogLocaleProp,
	ogLocaleAlternate: ogLocaleAlternateProp,
	defaultVisitorLang,
	alternateLocalePath,
	preloadLcpImage,
	preloadLcpImageSrcset,
	preloadLcpImageSizes,
} = Astro.props;

const visitorLang = visitorLangFromPath(Astro.url.pathname);
const translationsBase64 = Buffer.from(JSON.stringify(translations), 'utf-8').toString('base64');
const defaultLang = 'es';
const htmlLang = htmlLangProp ?? defaultLang;
const ogLocale = ogLocaleProp ?? "es_ES";
const ogLocaleAlternate = ogLocaleAlternateProp ?? "en_US";
/** Sufijo corto para `<title>` y OG: evita títulos duplicados y largos en todas las URLs. */
const BRAND = "L2Titan";
const fullTitle = title.trim() === BRAND ? BRAND : `${title.trim()} | ${BRAND}`;
const canonicalURL = absoluteUrl(canonicalPath ?? Astro.url.pathname);
const ogImageURL = new URL(ogImage, SITE_URL).toString();
const robotsContent = robots ?? (noindex
	? "noindex, nofollow"
	: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1");
---

<!doctype html>
<html lang={htmlLang} class="dark">
	<head>
		{defaultVisitorLang === "en" && (
			<script is:inline>
				try {
					localStorage.setItem("language", "en");
				} catch (e) {}
			</script>
		)}
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Primary SEO Meta Tags -->
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content="L2Titan" />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={canonicalURL} />

		{alternateLocalePath && (() => {
			const isEnPage = htmlLang === 'en';
			const enPath  = isEnPage ? (canonicalPath ?? Astro.url.pathname) : alternateLocalePath;
			const esPath  = isEnPage ? alternateLocalePath : (canonicalPath ?? Astro.url.pathname);
			return (
				<>
					<link rel="alternate" hreflang="es" href={absoluteUrl(esPath)} />
					<link rel="alternate" hreflang="en" href={absoluteUrl(enPath)} />
					<link rel="alternate" hreflang="x-default" href={absoluteUrl(esPath)} />
				</>
			);
		})()}

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:site_name" content="L2Titan" />
		<meta property="og:locale" content={ogLocale} />
		<meta property="og:locale:alternate" content={ogLocaleAlternate} />
		{articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonicalURL} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<!-- Additional SEO Meta -->
		<meta name="theme-color" content="#000000" />
		<meta name="application-name" content="L2Titan" />
		<meta name="apple-mobile-web-app-title" content="L2Titan" />

		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		{preloadLcpImage && preloadLcpImageSrcset ? (
			<link
				rel="preload"
				as="image"
				type="image/webp"
				href={preloadLcpImage}
				imagesrcset={preloadLcpImageSrcset}
				imagesizes={preloadLcpImageSizes ?? "100vw"}
				fetchpriority="high"
			/>
		) : (
			preloadLcpImage && (
				<link rel="preload" as="image" href={preloadLcpImage} fetchpriority="high" />
			)
		)}

		<!-- Resolución DNS anticipada para terceros bajo el fold (botones de voto): ahorra ~100ms al primer clic sin abrir TCP/TLS eager innecesario. -->
		<link rel="dns-prefetch" href="https://l2network.eu" />
		<link rel="dns-prefetch" href="https://www.top100arena.com" />
		<link rel="dns-prefetch" href="https://top.l2jbrasil.com" />
		<link rel="dns-prefetch" href="https://l2.hopzone.net" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="preload"
			as="style"
			href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;600&display=swap"
			onload="this.onload=null;this.rel='stylesheet'"
		/>
		<noscript>
			<link
				href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700;900&family=Inter:wght@300;400;600&display=swap"
				rel="stylesheet"
			/>
		</noscript>

		<meta name="generator" content={Astro.generator} />

		<!-- JSON-LD Structured Data -->
		{structuredData.map((entry) => (
			<script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
		))}
		<style is:inline>
			/* Visible by default so FCP/LCP are not blocked waiting for i18n (PageSpeed / CrUX). */
			body {
				opacity: 1;
			}
		</style>
		<script is:inline define:vars={{ translationsBase64 }}>
			(function() {
				// Execute immediately before body renders
				const binary = atob(translationsBase64);
				const bytes = Uint8Array.from(binary, (char) => char.charCodeAt(0));
				const translationsData = JSON.parse(new TextDecoder().decode(bytes));

				// Make functions globally available
				window.i18n = {
					getLanguage: function() {
						if (typeof localStorage !== 'undefined') {
							const saved = localStorage.getItem('language');
							if (saved === 'es' || saved === 'en') return saved;
						}
						if (typeof window !== 'undefined' && window.location && window.location.pathname) {
							const path = window.location.pathname;
							if (path === '/en' || path.startsWith('/en/')) return 'en';
						}
						return 'es';
					},
					getTranslation: function(key, lang) {
						const currentLang = lang || window.i18n.getLanguage();
						const keys = key.split('.');
						let value = translationsData[currentLang];
						
						for (const k of keys) {
							value = value?.[k];
							if (value === undefined) {
								console.warn('Translation key not found: ' + key);
								return key;
							}
						}
						
						return typeof value === 'string' ? value : key;
					},
					updateTranslations: function() {
						const lang = window.i18n.getLanguage();
						document.documentElement.lang = lang;
						const elements = document.querySelectorAll('[data-i18n]');
						
						elements.forEach((element) => {
							const key = element.getAttribute('data-i18n');
							if (key) {
								const translation = window.i18n.getTranslation(key, lang);
								if (element.tagName === 'INPUT' || element.tagName === 'TEXTAREA') {
									element.placeholder = translation;
								} else {
									element.textContent = translation;
								}
							}
						});

						// Bloques con markup interno (strong/code): innerHTML en vez de textContent.
						// Los valores son HTML estático propio (sin entrada de usuario) → seguro.
						const htmlElements = document.querySelectorAll('[data-i18n-html]');
						htmlElements.forEach((element) => {
							const key = element.getAttribute('data-i18n-html');
							if (key) {
								element.innerHTML = window.i18n.getTranslation(key, lang);
							}
						});

						// Update title attributes
						const titleElements = document.querySelectorAll('[data-i18n-title]');
						titleElements.forEach((element) => {
							const key = element.getAttribute('data-i18n-title');
							if (key) {
								element.setAttribute('title', window.i18n.getTranslation(key, lang));
							}
						});

						// Update alt attributes
						const altElements = document.querySelectorAll('[data-i18n-alt]');
						altElements.forEach((element) => {
							const key = element.getAttribute('data-i18n-alt');
							if (key) {
								element.alt = window.i18n.getTranslation(key, lang);
							}
						});

						// Update aria-label attributes
						const ariaLabelElements = document.querySelectorAll('[data-i18n-aria-label]');
						ariaLabelElements.forEach((element) => {
							const key = element.getAttribute('data-i18n-aria-label');
							if (key) {
								element.setAttribute('aria-label', window.i18n.getTranslation(key, lang));
							}
						});

						// Update language indicator in navbar
						const langIndicator = document.getElementById('current-language');
						if (langIndicator) {
							langIndicator.textContent = lang.toUpperCase();
						}

						// Show body once translations are applied
						if (document.body) {
							document.body.classList.add('i18n-ready');
						}
					},
					setLanguage: function(lang) {
						if (typeof localStorage !== 'undefined') {
							localStorage.setItem('language', lang);
						}
						window.i18n.updateTranslations();
						// Dispatch custom event for other components
						window.dispatchEvent(new CustomEvent('languagechange', { detail: { language: lang } }));
					}
				};

				// Set initial language attribute immediately if document is available
				if (typeof document !== 'undefined' && document.documentElement) {
					const initialLang = window.i18n.getLanguage();
					document.documentElement.lang = initialLang;
				}
			})();
		</script>

	</head>
	<body
		class="min-h-screen flex flex-col bg-black text-slate-200 overflow-x-hidden"
	>
		<a
			href="#main-content"
			class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-yellow-500 focus:px-4 focus:py-2 focus:text-black focus:font-bold focus:shadow-lg"
			data-i18n="a11y.skipToContent"
		>
			{translate("a11y.skipToContent", visitorLang, "Saltar al contenido")}
		</a>
		<Navbar />
		<main id="main-content" tabindex="-1" class="grow pb-[4.25rem] md:pb-0 focus:outline-none">
			<slot />
		</main>
		<a
			href="/downloads"
			class="fixed bottom-0 inset-x-0 z-40 flex md:hidden items-center justify-center gap-2 border-t border-yellow-600/40 bg-yellow-500 px-4 py-3 text-sm font-bold uppercase tracking-wider text-black hover:bg-yellow-400 transition-colors shadow-[0_-8px_24px_rgba(0,0,0,0.45)] pb-[max(0.75rem,env(safe-area-inset-bottom))]"
			data-i18n="home.downloadClient"
		>
			<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
			</svg>
			{translate("home.downloadClient", visitorLang, "Descargar Cliente")}
		</a>
		<Footer />
		<noscript>
			<style>
				body { opacity: 1 !important; }
			</style>
		</noscript>
		<script is:inline>
			// Apply translations synchronously immediately when body is parsed (before paint)
			(function() {
				if (window.i18n && typeof window.i18n.updateTranslations === 'function') {
					// Ensure html lang attribute is set based on detected language
					const lang = window.i18n.getLanguage();
					if (document.documentElement) {
						document.documentElement.lang = lang;
					}
					// Apply translations immediately - this executes synchronously before browser paints
					window.i18n.updateTranslations();
					// Ensure body is visible
					if (document.body) {
						document.body.classList.add('i18n-ready');
					}
				} else {
					// Fallback: show content if i18n system fails to initialize
					if (document.body) {
						document.body.classList.add('no-js');
					}
				}
			})();
		</script>
		<!-- Estado juego/login: al final del body + retraso tras load → no encadena con CSS en critical path (PSI) -->
		<script is:inline>
			(function () {
				var dotBase = 'inline-block w-2 h-2 rounded-full transition-colors ';
				function applyStatus(id, statusClass) {
					var el = document.getElementById(id);
					if (el) el.className = dotBase + statusClass;
				}
				function fetchServerStatus() {
					var gameDot = document.getElementById('status-game-dot');
					var loginDot = document.getElementById('status-login-dot');
					if (!gameDot || !loginDot) return;
					fetch('/status.json')
						.then(function (res) {
							return res.json();
						})
						.then(function (data) {
							var gameClass = data.game === 'online' ? 'status-online' : 'status-offline';
							var loginClass = data.login === 'online' ? 'status-online' : 'status-offline';
							applyStatus('status-game-dot', gameClass);
							applyStatus('status-game-dot-mobile', gameClass);
							applyStatus('status-login-dot', loginClass);
							applyStatus('status-login-dot-mobile', loginClass);
						})
						.catch(function () {
							var fallback = 'bg-gray-500';
							applyStatus('status-game-dot', fallback);
							applyStatus('status-game-dot-mobile', fallback);
							applyStatus('status-login-dot', fallback);
							applyStatus('status-login-dot-mobile', fallback);
						});
				}
				var pollingStarted = false;
				function startStatusPolling() {
					if (pollingStarted) return;
					pollingStarted = true;
					fetchServerStatus();
					setInterval(fetchServerStatus, 60000);
				}
				function kick() {
					if ('requestIdleCallback' in window) {
						requestIdleCallback(function () { startStatusPolling(); }, { timeout: 3000 });
					} else {
						setTimeout(startStatusPolling, 800);
					}
				}
				// status.json es estático y barato: arrancar al cargar (sin esperar interacción)
				// para que los dots muestren el estado real ya en el primer paint útil.
				if (document.readyState === 'complete') {
					kick();
				} else {
					window.addEventListener('load', kick, { once: true });
				}
			})();
		</script>
	</body>
</html>

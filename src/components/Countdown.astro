---
interface Props {
  targetDate: string;
}

const { targetDate } = Astro.props;
---

<div class="countdown-container text-center p-8 shadow-2xl max-w-3xl mx-auto mt-10 rounded-xl">
  <!-- Countdown active state -->
  <div id="countdown-active">
    <h2 class="text-3xl md:text-4xl font-bold text-yellow-500 mb-4 uppercase tracking-widest font-display" data-i18n="countdown.title">Servidor en línea</h2>
    <p class="text-xl md:text-2xl text-gray-300 mb-8 uppercase tracking-wide" data-i18n="countdown.subtitle">Temporada activa</p>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="flex flex-col p-4 df-surface hover:border-yellow-500/30 transition-colors">
        <span class="text-4xl md:text-6xl font-bold text-white" id="days">00</span>
        <span class="text-sm text-gray-400 uppercase tracking-wider mt-2" data-i18n="countdown.days">Días</span>
      </div>
      <div class="flex flex-col p-4 df-surface hover:border-yellow-500/30 transition-colors">
        <span class="text-4xl md:text-6xl font-bold text-white" id="hours">00</span>
        <span class="text-sm text-gray-400 uppercase tracking-wider mt-2" data-i18n="countdown.hours">Horas</span>
      </div>
      <div class="flex flex-col p-4 df-surface hover:border-yellow-500/30 transition-colors">
        <span class="text-4xl md:text-6xl font-bold text-white" id="minutes">00</span>
        <span class="text-sm text-gray-400 uppercase tracking-wider mt-2" data-i18n="countdown.minutes">Minutos</span>
      </div>
      <div class="flex flex-col p-4 df-surface hover:border-yellow-500/30 transition-colors">
        <span class="text-4xl md:text-6xl font-bold text-white" id="seconds">00</span>
        <span class="text-sm text-gray-400 uppercase tracking-wider mt-2" data-i18n="countdown.seconds">Segundos</span>
      </div>
    </div>
  </div>
</div>

<script is:inline define:vars={{ targetDate }}>
  const target = new Date(targetDate).getTime();
  const ids = ['days', 'hours', 'minutes', 'seconds'];
  const els = {};
  ids.forEach((id) => (els[id] = document.getElementById(id)));

  // Si falta algún nodo (markup cambió), no arrancar: evita TypeError en getElementById(...).innerText
  if (ids.every((id) => els[id])) {
    let intervalId;
    const set = (id, v) => (els[id].innerText = v);

    function showExpired() {
      ids.forEach((id) => set(id, '00'));
      if (intervalId) clearInterval(intervalId);
    }

    function updateCountdown() {
      const distance = target - Date.now();
      if (distance < 0) {
        showExpired();
        return;
      }
      const days = Math.floor(distance / 86400000);
      const hours = Math.floor((distance % 86400000) / 3600000);
      const minutes = Math.floor((distance % 3600000) / 60000);
      const seconds = Math.floor((distance % 60000) / 1000);
      set('days', String(days).padStart(2, '0'));
      set('hours', String(hours).padStart(2, '0'));
      set('minutes', String(minutes).padStart(2, '0'));
      set('seconds', String(seconds).padStart(2, '0'));
    }

    intervalId = setInterval(updateCountdown, 1000);
    updateCountdown();
  }
</script>

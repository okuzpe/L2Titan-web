---
import { baseRates, bossRates, vipBonus } from '../../data/serverInfo';
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { createTabLabel } from '../../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);
const ratesLabel = createTabLabel('rates', lang);
---

<div class="grid md:grid-cols-3 gap-8">
  <div class="md:col-span-3 rounded-2xl border border-yellow-500/15 bg-linear-to-r from-yellow-500/10 via-slate-900/80 to-slate-950/90 p-5 md:p-6">
    <p class="df-kicker mb-2" data-i18n="info.ratesTab.heroKicker">{ratesLabel('heroKicker')}</p>
    <h3 class="text-2xl font-bold text-yellow-400 font-display mb-3" data-i18n="info.ratesTab.heroTitle">{ratesLabel('heroTitle')}</h3>
    <p class="max-w-3xl text-sm md:text-base text-gray-300 leading-relaxed" data-i18n="info.ratesTab.heroLead">{ratesLabel('heroLead')}</p>
  </div>

  <!-- Base Rates -->
  <div class="df-surface p-8 rounded-xl border border-white/10 hover:border-yellow-500/30 transition-all duration-300 h-full">
    <h3 class="text-2xl font-bold text-yellow-500 mb-6 font-display border-b border-yellow-500/30 pb-3" data-i18n="info.ratesTab.baseRates">Rates Base</h3>
    <div class="space-y-3">
      {baseRates.map((rate) => (
        <div class="flex justify-between items-center p-3 bg-black/40 rounded border border-white/5 hover:border-yellow-500/20 transition-colors">
          <span class="text-gray-300 text-sm uppercase tracking-wide" data-i18n={`info.ratesTab.${rate.key}`}>{ratesLabel(rate.key)}</span>
          <span class="text-yellow-400 font-bold text-lg font-display">{rate.value}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Boss Rates -->
  <div class="df-surface p-8 rounded-xl border border-white/10 hover:border-yellow-500/30 transition-all duration-300 h-full">
    <h3 class="text-2xl font-bold text-yellow-500 mb-6 font-display border-b border-yellow-500/30 pb-3" data-i18n="info.ratesTab.bossRates">Rates de Bosses</h3>
    <div class="space-y-3">
      {bossRates.map((rate) => (
        <div class="flex justify-between items-center p-3 bg-black/40 rounded border border-white/5 hover:border-yellow-500/20 transition-colors">
          <span class="text-gray-300 text-sm uppercase tracking-wide" data-i18n={`info.ratesTab.${rate.key}`}>{ratesLabel(rate.key)}</span>
          <span class="text-yellow-400 font-bold text-lg font-display">{rate.value}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- VIP Bonus -->
  <div class="df-surface p-8 rounded-xl border border-white/10 hover:border-yellow-500/30 transition-all duration-300 h-full">
    <h3 class="text-2xl font-bold text-yellow-500 mb-2 font-display border-b border-yellow-500/30 pb-3" data-i18n="info.ratesTab.vipBonus">Bonus VIP</h3>
    <p class="text-xs text-gray-500 mb-6" data-i18n="info.ratesTab.vipBonusNote">Multiplicador adicional sobre las rates base</p>
    <div class="space-y-3">
      {vipBonus.map((bonus) => (
        <div class="flex justify-between items-center p-3 bg-black/40 rounded border border-white/5 hover:border-yellow-500/20 transition-colors">
          <span class="text-gray-300 text-sm uppercase tracking-wide" data-i18n={`info.ratesTab.${bonus.key}`}>{ratesLabel(bonus.key)}</span>
          <span class="text-green-400 font-bold text-lg font-display">{bonus.value}</span>
        </div>
      ))}
    </div>
  </div>
</div>

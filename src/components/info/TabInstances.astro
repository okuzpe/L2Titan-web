---
import { dailyInstances, neutralZoneHighlights } from '../../data/serverInfo';
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { createTabLabel } from '../../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);

const instanceImages: Record<number, string> = {
  1: '/images/Instance.jpg',
  2: '/images/infinitum-tower.webp',
};

const instanceLabel = createTabLabel('instances', lang);

const instanceCopy: Record<number, { maxEntriesKey: string; focusKey: string; drops: string[]; notes: string[] }> = {
  1: {
    maxEntriesKey: 'daily1MaxEntries',
    focusKey: 'daily1Focus',
    drops: ['daily1Drop1', 'daily1Drop2', 'daily1Drop3'],
    notes: ['daily1Note1', 'daily1Note2'],
  },
  2: {
    maxEntriesKey: 'daily2MaxEntries',
    focusKey: 'daily2Focus',
    drops: ['daily2Drop1', 'daily2Drop2', 'daily2Drop3'],
    notes: ['daily2Note1', 'daily2Note2'],
  },
};
---

<div class="df-surface p-6 rounded-xl border border-yellow-500/20 mb-8">
  <div class="mb-4">
    <h2 class="text-xl md:text-2xl uppercase tracking-wide text-yellow-400 font-display font-bold" data-i18n="info.instancesTab.instancesSectionTitle">Instancias diarias</h2>
    <p class="text-sm text-gray-400 mt-1" data-i18n="info.instancesTab.instancesSectionDesc">Contenido con tiempo y reglas de instancia.</p>
  </div>

  <div class="grid gap-3 md:grid-cols-3 mb-5">
    <div class="rounded-xl border border-yellow-500/20 bg-yellow-500/10 p-3">
      <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-400" data-i18n="info.instancesTab.activeInstancesLabel">{instanceLabel('activeInstancesLabel')}</p>
      <p class="mt-1 text-lg font-bold text-white">{dailyInstances.length}</p>
    </div>
    <div class="rounded-xl border border-yellow-500/20 bg-yellow-500/10 p-3">
      <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-300" data-i18n="info.instancesTab.dailyResetLabel">{instanceLabel('dailyResetLabel')}</p>
      <p class="mt-1 text-lg font-bold text-white">06:30 AM</p>
    </div>
    <div class="rounded-xl border border-yellow-500/20 bg-yellow-500/10 p-3">
      <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-400" data-i18n="info.instancesTab.keyCommandLabel">{instanceLabel('keyCommandLabel')}</p>
      <p class="mt-1 text-lg font-bold text-white font-mono">.daily</p>
    </div>
  </div>

  <div class="bg-black/30 p-4 rounded-xl border border-white/10 mb-5">
    <h3 class="text-xl font-bold text-yellow-500 mb-4 font-display" data-i18n="info.instancesTab.howItWorks">Como funciona</h3>
    <div class="grid sm:grid-cols-2 gap-3">
      {[
        { key: 'desc1', icon: 'TIME' },
        { key: 'desc2', icon: 'PAUSE' },
        { key: 'desc3', icon: 'RESET' },
        { key: 'desc4', icon: 'PARTY' },
      ].map((item) => (
        <div class="flex items-start gap-3 p-3 bg-black/40 rounded border border-white/5">
          <span class="text-xs shrink-0 rounded bg-yellow-500/10 px-2 py-1 text-yellow-400 tracking-wider">{item.icon}</span>
          <span class="text-gray-300 text-sm" data-i18n={`info.instancesTab.${item.key}`}>{instanceLabel(item.key)}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="bg-black/30 p-5 rounded-xl border border-yellow-500/20 mb-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-3xl">
        <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-400 mb-2" data-i18n="info.instancesTab.lettersKicker">{instanceLabel('lettersKicker')}</p>
        <h3 class="text-xl font-bold text-yellow-400 mb-3 font-display" data-i18n="info.instancesTab.lettersTitle">{instanceLabel('lettersTitle')}</h3>
        <p class="text-sm text-gray-300 mb-3" data-i18n="info.instancesTab.lettersIntro">
          {instanceLabel('lettersIntro')}
        </p>
        <p class="text-xs text-gray-500" data-i18n="info.instancesTab.lettersNote">
          {instanceLabel('lettersNote')}
        </p>
      </div>
      <div class="rounded-xl border border-yellow-500/15 bg-yellow-500/10 px-4 py-3 text-sm text-yellow-200">
        <span class="block text-[11px] uppercase tracking-[0.2em] text-yellow-400/80 mb-1" data-i18n="info.instancesTab.realAccessLabel">{instanceLabel('realAccessLabel')}</span>
        <code class="font-mono text-base text-white">.daily enter 2</code>
      </div>
    </div>
  </div>

  <div>
    <div class="flex flex-col gap-2 mb-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="df-kicker-muted" data-i18n="info.instancesTab.dailyRoutesKicker">{instanceLabel('dailyRoutesKicker')}</p>
        <h3 class="text-lg md:text-xl font-bold text-white font-display" data-i18n="info.instancesTab.dailyRoutesTitle">{instanceLabel('dailyRoutesTitle')}</h3>
      </div>
      <p class="max-w-xl text-sm text-gray-500" data-i18n="info.instancesTab.dailyRoutesDesc">
        {instanceLabel('dailyRoutesDesc')}
      </p>
    </div>

    <div class="space-y-6">
      {dailyInstances.map((instance) => (
        <article class="bg-black/30 p-5 rounded-xl border border-white/10 hover:border-purple-400/30 transition-colors h-full flex flex-col">
          <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
            <div>
              <p class="text-xs uppercase tracking-[0.22em] text-yellow-500">Daily #{instance.id}</p>
              <h3 class="text-xl font-bold text-yellow-400 font-display">{instance.name}</h3>
            </div>
            <div class="flex flex-wrap gap-2">
              <code class="bg-yellow-500/10 text-yellow-400 px-3 py-1 rounded text-xs">{instance.access}</code>
              <span class="rounded bg-yellow-500/10 px-3 py-1 text-xs text-yellow-400">{instance.focus}</span>
            </div>
          </div>

          <div class="rounded-xl overflow-hidden border border-white/10 bg-black/40 mb-4">
            <div class="aspect-video">
              <img
                src={instanceImages[instance.id] ?? '/images/background.jpg'}
                alt={instance.name}
                class="w-full h-full object-cover object-center"
                loading="lazy"
              />
            </div>
          </div>

          <div class="grid gap-2 sm:grid-cols-3 text-sm">
            <div class="rounded-lg bg-black/30 p-3">
              <span class="block text-[11px] uppercase tracking-[0.18em] text-gray-500" data-i18n="info.instancesTab.maxTimeLabel">{instanceLabel('maxTimeLabel')}</span>
              <span class="mt-1 block text-gray-200">{instance.maxTime}</span>
            </div>
            <div class="rounded-lg bg-black/30 p-3">
              <span class="block text-[11px] uppercase tracking-[0.18em] text-gray-500" data-i18n="info.instancesTab.entriesPerDayLabel">{instanceLabel('entriesPerDayLabel')}</span>
              <span class="mt-1 block text-gray-200" data-i18n={`info.instancesTab.${instanceCopy[instance.id].maxEntriesKey}`}>{instanceLabel(instanceCopy[instance.id].maxEntriesKey)}</span>
            </div>
            <div class="rounded-lg bg-black/30 p-3">
              <span class="block text-[11px] uppercase tracking-[0.18em] text-gray-500" data-i18n="info.instancesTab.levelRangeLabel">{instanceLabel('levelRangeLabel')}</span>
              <span class="mt-1 block text-gray-200">{instance.levelRange}</span>
            </div>
          </div>

          <div class="mt-4 p-3 bg-yellow-500/10 rounded border border-yellow-500/20">
            <p class="text-xs uppercase tracking-wider text-yellow-400 mb-1" data-i18n="info.instancesTab.primaryGoalLabel">{instanceLabel('primaryGoalLabel')}</p>
            <p class="text-sm text-gray-300" data-i18n={`info.instancesTab.${instanceCopy[instance.id].focusKey}`}>{instanceLabel(instanceCopy[instance.id].focusKey)}</p>
          </div>

          <div class="mt-4">
            <p class="text-sm font-bold text-yellow-500 mb-2" data-i18n="info.instancesTab.mainDropsLabel">{instanceLabel('mainDropsLabel')}</p>
            <div class="space-y-2">
              {instanceCopy[instance.id].drops.map((dropKey) => (
                <div class="p-3 bg-black/40 rounded border border-white/5 text-sm text-gray-300" data-i18n={`info.instancesTab.${dropKey}`}>{instanceLabel(dropKey)}</div>
              ))}
            </div>
          </div>

          <div class="mt-5 border-t border-white/10 pt-4">
            <p class="text-sm font-bold text-yellow-500 mb-2" data-i18n="info.instancesTab.usefulNotesLabel">{instanceLabel('usefulNotesLabel')}</p>
            <div class="space-y-2">
              {instanceCopy[instance.id].notes.map((noteKey) => (
                <div class="flex items-start gap-2 text-sm text-gray-400">
                  <svg class="w-4 h-4 text-green-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  <span data-i18n={`info.instancesTab.${noteKey}`}>{instanceLabel(noteKey)}</span>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="mt-6 bg-black/30 p-5 rounded-xl border border-red-500/20">
    <h3 class="text-lg font-bold text-red-400 mb-4 font-display" data-i18n="info.instancesTab.restrictions">Restricciones</h3>
    <ul class="grid gap-2 md:grid-cols-2">
      {['restrict1', 'restrict2', 'restrict3', 'restrict4'].map((restrictionKey) => (
        <li class="flex items-start gap-2 rounded-lg bg-black/20 p-3 text-gray-400 text-sm">
          <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          <span data-i18n={`info.instancesTab.${restrictionKey}`}>{instanceLabel(restrictionKey)}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<div class="df-surface p-6 rounded-xl border border-yellow-500/20">
  <div class="mb-4">
    <h2 class="text-xl md:text-2xl uppercase tracking-wide text-yellow-300 font-display font-bold" data-i18n="info.instancesTab.customZoneSectionTitle">Zona custom</h2>
    <p class="text-sm text-gray-400 mt-1" data-i18n="info.instancesTab.customZoneSectionDesc">Zona abierta de farmeo/PvP con balance propio.</p>
  </div>
  <h3 class="text-lg md:text-xl font-bold text-yellow-400 mb-1 font-display" data-i18n="info.instancesTab.neutralZoneTitle">Neutral Zone (rework)</h3>
  <p class="text-sm text-gray-400 mb-4" data-i18n="info.instancesTab.neutralZoneIntro">Zona PvP activa con ajustes de flujo, mobs y economía.</p>
  <div class="grid lg:grid-cols-2 gap-5">
    <div class="rounded-xl overflow-hidden border border-white/10 bg-black/40">
      <div class="aspect-video">
        <img
          src="/images/NeutralZone.jpg"
          alt="Neutral Zone"
          class="w-full h-full object-cover object-center"
          loading="lazy"
        />
      </div>
    </div>
    <div class="space-y-2">
      {neutralZoneHighlights.map((key) => (
        <div class="flex items-start gap-2 p-3 bg-black/30 rounded border border-white/5 text-sm">
          <svg class="w-4 h-4 text-yellow-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-300" data-i18n={`info.instancesTab.${key}`}>{instanceLabel(key)}</span>
        </div>
      ))}
    </div>
  </div>
  <div class="mt-4 bg-black/30 rounded-xl border border-white/10 p-4">
    <h4 class="text-base font-bold text-yellow-400 mb-2 uppercase tracking-wider font-display" data-i18n="info.instancesTab.neutralDropSummaryTitle">Drops (Neutral Zone)</h4>
    <div class="space-y-2 text-sm">
      <p class="text-gray-300" data-i18n="info.instancesTab.neutralDropSummaryDrop">
        Drop: Adena + materiales de crafteo (Mold Glue/Lubricant/Hardener, Enria, Asofe, Thons, Varnish of Purity, Synthetic Cokes, Compound Braid, Mithril Alloy, Durable Metal Plate, Blacksmith's Frame, High Grade Suede, Oriharukon Ore, Mithril Ore, Adamantite Nugget, Oriharukon).
      </p>
      <p class="text-gray-300" data-i18n="info.instancesTab.neutralDropSummarySpoil">
        Spoil: Sealed gear/jewelry A-S (Draconic Leather, Imperial Crusader, Major Arcana).
      </p>
      <p class="text-xs text-gray-500" data-i18n="info.instancesTab.neutralDropSummaryMobs">
        Referencia rápida util para ubicar la zona y planear el farmeo.
      </p>
    </div>
  </div>
</div>

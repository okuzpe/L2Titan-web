---
import { eventSchedule } from '../../data/serverInfo';

const eventColors: Record<string, string> = {
  TvT: 'bg-red-500/20 text-red-400 border-red-500/30',
  CTF: 'bg-blue-500/20 text-blue-400 border-blue-500/30',
  DM: 'bg-orange-500/20 text-orange-400 border-orange-500/30',
};
---

<div class="df-surface p-5 md:p-6 rounded-xl border border-yellow-500/20 mb-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-400/75" data-i18n="info.eventsTab.introKicker">Agenda PvP</p>
      <h3 class="text-xl md:text-2xl font-bold text-yellow-400 font-display" data-i18n="info.eventsTab.introTitle">Calendario, estado y reglas separados por evento</h3>
    </div>
    <p class="max-w-2xl text-sm text-gray-400 leading-relaxed" data-i18n="info.eventsTab.introDesc">
      La ficha queda organizada para leer rapido que evento esta activo, que reglas usa cada modo y que recompensas estan configuradas ahora mismo.
    </p>
  </div>
</div>

<!-- Schedule -->
<div class="df-surface p-6 rounded-xl border border-white/10 mb-8">
  <h3 class="text-2xl font-bold text-yellow-500 mb-2 font-display" data-i18n="info.eventsTab.schedule">Horario Completo</h3>
  <p class="text-gray-500 text-sm mb-4" data-i18n="info.eventsTab.scheduleNote">Eventos programados por hora (sujeto a mantenimiento, reinicios o asedios)</p>
  <div class="grid grid-cols-4 sm:grid-cols-6 md:grid-cols-8 lg:grid-cols-12 gap-2">
    {eventSchedule.map((ev) => (
      <div class={`p-2 rounded border text-center ${ev.active ? eventColors[ev.type] : 'bg-gray-500/10 text-gray-500 border-gray-700/40'}`}>
        <div class="text-xs font-mono opacity-70">{ev.hour}</div>
        <div class="font-bold text-sm" data-i18n={`info.eventsTab.${ev.type.toLowerCase()}`}>{ev.type}</div>
        <div class={`text-[10px] mt-0.5 ${ev.active ? 'text-green-400' : 'text-rose-400'}`} data-i18n={ev.active ? 'info.eventsTab.eventActive' : 'info.eventsTab.eventInactive'}>
          {ev.active ? 'ACTIVO' : 'PAUSADO'}
        </div>
      </div>
    ))}
  </div>
  <div class="flex gap-4 mt-4 text-xs">
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-red-500/40"></span><span data-i18n="info.eventsTab.tvt">TvT</span></span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-blue-500/40"></span><span data-i18n="info.eventsTab.ctf">CTF</span></span>
    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-orange-500/40"></span><span data-i18n="info.eventsTab.dm">DM</span></span>
  </div>
</div>

<div class="grid md:grid-cols-2 gap-4 mb-8">
  <div class="bg-blue-500/10 border border-blue-500/25 rounded-xl p-4 text-sm text-blue-300" data-i18n="info.eventsTab.ctfPaused">
    CTF automatico desactivado temporalmente
  </div>
  <div class="bg-orange-500/10 border border-orange-500/25 rounded-xl p-4 text-sm text-orange-300" data-i18n="info.eventsTab.dmPaused">
    DM automatico desactivado temporalmente
  </div>
</div>

<!-- Commands -->
<div class="df-surface p-4 rounded-xl border border-white/10 mb-8">
  <div class="flex flex-wrap gap-3 items-center">
    <span class="text-gray-400 text-sm font-bold uppercase tracking-wider" data-i18n="info.eventsTab.joinCommands">Comandos:</span>
    <code class="bg-yellow-500/10 text-yellow-400 px-3 py-1 rounded font-mono text-sm">.join</code>
    <span class="text-gray-500 text-sm" data-i18n="info.commandsTab.cmdJoin">Unirse al evento activo</span>
    <span class="text-gray-700">|</span>
    <code class="bg-yellow-500/10 text-yellow-400 px-3 py-1 rounded font-mono text-sm">.leave</code>
    <span class="text-gray-500 text-sm" data-i18n="info.commandsTab.cmdLeave">Abandonar el evento</span>
  </div>
</div>

<!-- Event Details -->
<div class="grid xl:grid-cols-3 gap-8">
  <div class="df-surface p-6 rounded-xl border border-red-500/20">
    <h3 class="text-xl font-bold text-red-400 mb-4 font-display" data-i18n="info.eventsTab.tvt">TvT (Team vs Team)</h3>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.format">Formato</span><span class="text-gray-200" data-i18n="info.eventsTab.tvtFormat">Blue vs Red (aleatorio)</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.level">Nivel</span><span class="text-gray-200">1 - 81</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.players">Jugadores</span><span class="text-gray-200">2 - 50</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.duration">Duracion</span><span class="text-gray-200" data-i18n="info.eventsTab.tvtDuration">5+5 min</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.location">Ubicacion</span><span class="text-gray-200" data-i18n="info.eventsTab.tvtLocation">Aden Colosseum</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.potions">Pociones</span><span class="text-green-400" data-i18n="info.eventsTab.allowed">Permitidas</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.summons">Summons</span><span class="text-red-400" data-i18n="info.eventsTab.notAllowed">No permitidos</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.revive">Revive</span><span class="text-gray-200" data-i18n="info.eventsTab.tvtRevive">Full, 5s delay</span></div>
      <div class="mt-3 p-3 bg-red-500/10 rounded border border-red-500/20">
        <p class="text-xs font-bold text-red-400 uppercase tracking-wider mb-2" data-i18n="info.eventsTab.configuredRewards">Recompensas configuradas</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.tvtReward1">Ganador: 25 Event Medals</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.tvtReward2">Perdedor: 15 Event Medals</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.tvtReward3">Kill reward: 1 Event Medal por enemigo derrotado</p>
        <p class="text-yellow-400 text-xs" data-i18n="info.eventsTab.tvtReward4">Top Killer: +10 Event Medals</p>
      </div>
    </div>
  </div>

  <div class="df-surface p-6 rounded-xl border border-blue-500/20">
    <h3 class="text-xl font-bold text-blue-400 mb-4 font-display" data-i18n="info.eventsTab.ctf">CTF (Capture the Flag)</h3>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.format">Formato</span><span class="text-gray-200" data-i18n="info.eventsTab.tvtFormat">Blue vs Red (aleatorio)</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.level">Nivel</span><span class="text-gray-200">1 - 80</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.players">Jugadores</span><span class="text-gray-200">2 - 50</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.duration">Duracion</span><span class="text-gray-200" data-i18n="info.eventsTab.ctfDuration">5+5 min</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.npcRegister">NPC registro</span><span class="text-gray-200" data-i18n="info.eventsTab.appearsGiran">Giran</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.potions">Pociones</span><span class="text-red-400" data-i18n="info.eventsTab.notAllowed">No permitidas</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.summons">Summons</span><span class="text-red-400" data-i18n="info.eventsTab.notAllowed">No permitidos</span></div>
      <div class="mt-3 p-3 bg-blue-500/10 rounded border border-blue-500/20">
        <p class="text-xs font-bold text-blue-400 uppercase tracking-wider mb-2" data-i18n="info.eventsTab.configuredRewards">Recompensas configuradas</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.ctfReward1">Ganador: 25 Event Medals</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.ctfReward2">Perdedor: 15 Event Medals</p>
        <p class="text-gray-500 text-xs" data-i18n="info.eventsTab.ctfReward3">Actualmente el evento automatico esta en pausa, pero la config guardada ya usa estos valores.</p>
      </div>
    </div>
  </div>

  <div class="df-surface p-6 rounded-xl border border-orange-500/20">
    <h3 class="text-xl font-bold text-orange-400 mb-4 font-display" data-i18n="info.eventsTab.dm">DM (Death Match)</h3>
    <div class="space-y-2 text-sm">
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.format">Formato</span><span class="text-gray-200" data-i18n="info.eventsTab.dmFormat">Free-for-all</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.level">Nivel</span><span class="text-gray-200">1 - 81</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.players">Jugadores</span><span class="text-gray-200">2 - 50</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.duration">Duracion</span><span class="text-gray-200" data-i18n="info.eventsTab.dmDuration">5+5 min</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.potions">Pociones</span><span class="text-green-400" data-i18n="info.eventsTab.allowed">Permitidas</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.healers">Healers</span><span class="text-green-400" data-i18n="info.eventsTab.allowed">Permitidos</span></div>
      <div class="flex justify-between p-2 bg-black/30 rounded"><span class="text-gray-400" data-i18n="info.eventsTab.revive">Revive</span><span class="text-gray-200" data-i18n="info.eventsTab.dmRevive">Full, 10s delay</span></div>
      <div class="mt-3 p-3 bg-orange-500/10 rounded border border-orange-500/20">
        <p class="text-xs font-bold text-orange-400 uppercase tracking-wider mb-2" data-i18n="info.eventsTab.configuredRewards">Recompensas configuradas</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.dmReward1">Ganador: 10 Event Medals</p>
        <p class="text-gray-300 text-xs" data-i18n="info.eventsTab.dmReward2">Kill reward: 1 Event Medal por kill</p>
        <p class="text-yellow-400 text-xs" data-i18n="info.eventsTab.dmReward3">Top Killer: +20 Event Medals</p>
        <p class="text-gray-500 text-xs" data-i18n="info.eventsTab.dmReward4">Actualmente el evento automatico esta en pausa.</p>
      </div>
    </div>
  </div>
</div>

<!-- General Rules -->
<div class="mt-8 rounded-2xl border border-yellow-500/15 bg-linear-to-r from-yellow-500/10 via-slate-900/85 to-slate-950/90 p-5 md:p-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between mb-5">
    <div>
      <p class="text-[11px] uppercase tracking-[0.24em] text-yellow-400/80 mb-2" data-i18n="info.eventsTab.generalKicker">Antes de entrar</p>
      <h3 class="text-xl md:text-2xl font-bold text-yellow-400 font-display" data-i18n="info.eventsTab.generalRules">Reglas generales</h3>
    </div>
    <p class="max-w-2xl text-sm text-gray-400 leading-relaxed" data-i18n="info.eventsTab.generalDesc">
      Estas restricciones se aplican a todos los modos para evitar cruces con Olympiad, dual-box abusivo o ventanas de asedio.
    </p>
  </div>
  <div class="grid gap-3 md:grid-cols-3">
    <div class="rounded-xl border border-white/10 bg-black/30 p-4">
      <span class="inline-flex rounded-full border border-yellow-500/20 bg-yellow-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-yellow-300">RULE 01</span>
      <p class="mt-3 text-sm leading-relaxed text-gray-300" data-i18n="info.eventsTab.rule1">No se puede participar si estas en Olympiad u otro evento</p>
    </div>
    <div class="rounded-xl border border-white/10 bg-black/30 p-4">
      <span class="inline-flex rounded-full border border-yellow-500/20 bg-yellow-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-yellow-300">RULE 02</span>
      <p class="mt-3 text-sm leading-relaxed text-gray-300" data-i18n="info.eventsTab.rule2">Restriccion de dual-box en eventos</p>
    </div>
    <div class="rounded-xl border border-white/10 bg-black/30 p-4">
      <span class="inline-flex rounded-full border border-yellow-500/20 bg-yellow-500/10 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.2em] text-yellow-300">RULE 03</span>
      <p class="mt-3 text-sm leading-relaxed text-gray-300" data-i18n="info.eventsTab.rule3">Los eventos no se ejecutan durante asedios de castillo</p>
    </div>
  </div>
</div>

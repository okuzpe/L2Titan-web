---
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { createTabLabel } from '../../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);
const featureLabel = createTabLabel('features', lang);
---

<div class="df-surface p-6 rounded-xl border border-white/10 h-full">
	<h4 class="text-lg font-bold text-yellow-400 mb-3 font-display" data-i18n="info.featuresTab.autoFarm">
		{featureLabel('autoFarm')}
	</h4>
	<ul class="space-y-2 text-sm text-gray-400">
		{['autoFarmDesc1', 'autoFarmDesc2', 'autoFarmDesc3', 'autoFarmDesc4'].map((key) => (
			<li class="flex items-start gap-2">
				<span class="text-yellow-500 mt-1 shrink-0">*</span>
				<span data-i18n={`info.featuresTab.${key}`}>{featureLabel(key)}</span>
			</li>
		))}
	</ul>
</div>

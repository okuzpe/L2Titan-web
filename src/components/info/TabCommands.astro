---
import { commands } from '../../data/serverInfo';
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { translate } from '../../utils/translations';

const categories = [
  { key: 'vip', icon: 'VIP' },
  { key: 'instances', icon: 'DAY' },
  { key: 'events', icon: 'PVP' },
  { key: 'rankings', icon: 'TOP' },
  { key: 'vote', icon: 'VOTE' },
  { key: 'teleport', icon: 'GK' },
  { key: 'bank', icon: 'BANK' },
  { key: 'marriage', icon: 'LOVE' },
  { key: 'utilities', icon: 'UTIL' },
];

const catTranslationKeys: Record<string, string> = {
  vip: 'catVip',
  instances: 'catInstances',
  events: 'catEvents',
  rankings: 'catRankings',
  vote: 'catVote',
  teleport: 'catTeleport',
  bank: 'catBank',
  marriage: 'catMarriage',
  utilities: 'catUtilities',
};

const lang = visitorLangFromPath(Astro.url.pathname);

const commandCategoryLabel = (key: string) =>
  translate(`info.commandsTab.${catTranslationKeys[key]}`, lang, key);

const commandDescription = (key: string) =>
  translate(`info.commandsTab.${key}`, lang, key);
---

<div class="bg-slate-900/50 p-5 md:p-6 rounded-xl border border-yellow-500/20 mb-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-400/75" data-i18n="info.commandsTab.introKicker">{commandDescription('introKicker')}</p>
      <h3 class="text-xl md:text-2xl font-bold text-yellow-400 font-display" data-i18n="info.commandsTab.introTitle">{commandDescription('introTitle')}</h3>
    </div>
    <p class="max-w-2xl text-sm text-gray-400 leading-relaxed" data-i18n="info.commandsTab.introDesc">
      {commandDescription('introDesc')}
    </p>
  </div>
</div>

<div class="grid md:grid-cols-2 2xl:grid-cols-3 gap-6">
  {categories.map((cat) => (
    <div class="bg-slate-900/50 p-6 rounded-xl border border-white/10 hover:border-yellow-500/20 transition-colors h-full">
      <h3 class="text-lg font-bold text-yellow-500 mb-4 font-display flex items-center gap-2">
        <span class="inline-flex min-w-10 justify-center rounded bg-yellow-500/10 px-2 py-1 text-[11px] tracking-wider">{cat.icon}</span>
        <span data-i18n={`info.commandsTab.${catTranslationKeys[cat.key]}`}>{commandCategoryLabel(cat.key)}</span>
      </h3>
      <div class="space-y-2">
        {commands[cat.key].map((cmd) => (
          <div class="flex flex-col gap-2 p-3 bg-black/40 rounded border border-white/5 hover:border-yellow-500/10 transition-colors">
            <code class="text-yellow-400 font-mono text-sm">{cmd.cmd}</code>
            <span class="text-gray-400 text-xs leading-relaxed" data-i18n={`info.commandsTab.${cmd.key}`}>{commandDescription(cmd.key)}</span>
          </div>
        ))}
      </div>
    </div>
  ))}
</div>

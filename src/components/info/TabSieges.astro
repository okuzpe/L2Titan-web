---
import {
  fortressList,
  castleList,
  fortressRewardSummary,
  castleRewardHighlights,
} from '../../data/serverInfo';
import { visitorLangFromPath } from '../../utils/i18n-lang';
import { translate } from '../../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);
const siegeLabel = (key: string) => translate(`info.siegesTab.${key}`, lang, key);
---

<div class="df-surface p-5 md:p-6 rounded-xl border border-yellow-500/20 mb-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-[11px] uppercase tracking-[0.22em] text-yellow-400/75" data-i18n="info.siegesTab.introKicker">{siegeLabel('introKicker')}</p>
      <h3 class="text-xl md:text-2xl font-bold text-yellow-400 font-display" data-i18n="info.siegesTab.introTitle">{siegeLabel('introTitle')}</h3>
    </div>
    <p class="max-w-2xl text-sm text-gray-400 leading-relaxed" data-i18n="info.siegesTab.introDesc">
      {siegeLabel('introDesc')}
    </p>
  </div>
</div>

<div class="grid xl:grid-cols-2 gap-8">
  <div>
    <div class="df-surface p-6 rounded-xl border border-white/10 mb-6">
      <h3 class="text-2xl font-bold text-yellow-500 mb-4 font-display" data-i18n="info.siegesTab.fortresses">Fortalezas</h3>

      <div class="space-y-2 text-sm mb-6">
        {[
          { key: 'fortressCount', icon: 'FORT' },
          { key: 'fortressDuration', icon: '60M' },
          { key: 'fortressClanLevel', icon: 'CL4' },
          { key: 'fortressCost', icon: '250K' },
        ].map((item) => (
          <div class="flex items-center gap-3 p-2 bg-black/30 rounded">
            <span class="shrink-0 text-[11px] rounded bg-yellow-500/10 px-2 py-1 text-yellow-400 tracking-wider">{item.icon}</span>
            <span class="text-gray-300" data-i18n={`info.siegesTab.${item.key}`}>{siegeLabel(item.key)}</span>
          </div>
        ))}
      </div>

      <h4 class="text-sm font-bold text-yellow-500 uppercase tracking-wider mb-3" data-i18n="info.siegesTab.howItWorks">Como funciona el asedio</h4>
      <div class="space-y-2 mb-6">
        {['siege1', 'siege2', 'siege3', 'siege4', 'siege5', 'siege6'].map((key, i) => (
          <div class="flex items-start gap-3 text-sm">
            <div class="w-6 h-6 rounded-full bg-yellow-500/20 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-yellow-500 font-bold text-xs">{i + 1}</span>
            </div>
            <span class="text-gray-400" data-i18n={`info.siegesTab.${key}`}>{siegeLabel(key)}</span>
          </div>
        ))}
      </div>

      <h4 class="text-sm font-bold text-yellow-500 uppercase tracking-wider mb-3" data-i18n="info.siegesTab.realRewardsTitle">{siegeLabel('realRewardsTitle')}</h4>
      <div class="space-y-2 mb-6">
        <div class="flex items-center gap-2 p-2 bg-black/30 rounded text-sm">
          <svg class="w-4 h-4 text-yellow-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-300">{fortressRewardSummary.leaderReward} <span data-i18n="info.siegesTab.fortressRewardLeaderSuffix">{siegeLabel('fortressRewardLeaderSuffix')}</span></span>
        </div>
        <div class="flex items-center gap-2 p-2 bg-black/30 rounded text-sm">
          <svg class="w-4 h-4 text-yellow-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-300">{fortressRewardSummary.conquerorReputation} <span data-i18n="info.siegesTab.fortressRewardConquerSuffix">{siegeLabel('fortressRewardConquerSuffix')}</span></span>
        </div>
        <div class="flex items-center gap-2 p-2 bg-black/30 rounded text-sm">
          <svg class="w-4 h-4 text-yellow-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-300">{fortressRewardSummary.defenderReputation} <span data-i18n="info.siegesTab.fortressRewardDefendSuffix">{siegeLabel('fortressRewardDefendSuffix')}</span></span>
        </div>
      </div>

      <h4 class="text-sm font-bold text-yellow-500 uppercase tracking-wider mb-3" data-i18n="info.siegesTab.ownerBenefits">Beneficios del propietario</h4>
      <div class="space-y-2">
        {['benefit2', 'benefit3'].map((key) => (
          <div class="flex items-center gap-2 p-2 bg-black/30 rounded text-sm">
            <svg class="w-4 h-4 text-green-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span class="text-gray-300" data-i18n={`info.siegesTab.${key}`}>{siegeLabel(key)}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div>
    <div class="df-surface p-6 rounded-xl border border-white/10 mb-6">
      <h3 class="text-2xl font-bold text-yellow-500 mb-4 font-display" data-i18n="info.siegesTab.castleSieges">Asedios de Castillo</h3>
      <div class="space-y-2 text-sm">
        {[
          { label: 'castleDuration', val: 'castleDurationVal' },
          { label: 'castleFlags', val: 'castleFlagsVal' },
          { label: 'castleClanLevel', val: 'castleClanLevelVal' },
          { label: 'castleAttackerRespawn', val: 'castleAttackerRespawnVal' },
          { label: 'castleDefenderRespawn', val: 'castleDefenderRespawnVal' },
          { label: 'castleTeleport', val: 'castleTeleportVal' },
        ].map((item) => (
          <div class="flex justify-between p-3 bg-black/40 rounded border border-white/5">
            <span class="text-gray-400" data-i18n={`info.siegesTab.${item.label}`}>{siegeLabel(item.label)}</span>
            <span class="text-gray-200 font-medium" data-i18n={`info.siegesTab.${item.val}`}>{siegeLabel(item.val)}</span>
          </div>
        ))}
      </div>

      <h4 class="text-sm font-bold text-yellow-500 uppercase tracking-wider mb-3 mt-6" data-i18n="info.siegesTab.castleRewardsTitle">{siegeLabel('castleRewardsTitle')}</h4>
      <p class="text-xs text-gray-500 mb-3" data-i18n="info.siegesTab.castleRewardsDesc">{siegeLabel('castleRewardsDesc')}</p>
      <div class="grid sm:grid-cols-2 gap-2">
        {castleRewardHighlights.map((castle) => (
          <div class="p-3 bg-black/30 rounded border border-yellow-500/10 text-sm">
            <div class="text-yellow-400 font-semibold">{castle.castle}</div>
            <div class="text-gray-300">{castle.reward}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<div class="mt-8 rounded-2xl border border-yellow-500/15 bg-linear-to-r from-yellow-500/10 via-slate-900/85 to-slate-950/90 p-5 md:p-6">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between mb-5">
    <div>
      <p class="text-[11px] uppercase tracking-[0.24em] text-yellow-400/80 mb-2" data-i18n="info.siegesTab.mapKicker">{siegeLabel('mapKicker')}</p>
      <h3 class="text-xl md:text-2xl font-bold text-yellow-400 font-display" data-i18n="info.siegesTab.mapTitle">{siegeLabel('mapTitle')}</h3>
    </div>
    <p class="max-w-2xl text-sm text-gray-400 leading-relaxed" data-i18n="info.siegesTab.mapDesc">
      {siegeLabel('mapDesc')}
    </p>
  </div>
  <div class="grid gap-6 xl:grid-cols-2">
    <div class="rounded-xl border border-white/10 bg-black/30 p-4">
      <h4 class="text-sm font-bold text-yellow-500 uppercase tracking-wider mb-3" data-i18n="info.siegesTab.fortressList">Lista de Fortalezas (21)</h4>
      <div class="flex flex-wrap gap-2">
        {fortressList.map((fort) => (
          <span class="px-3 py-1 bg-black/40 rounded border border-white/10 text-gray-300 text-xs">{fort}</span>
        ))}
      </div>
    </div>
    <div class="rounded-xl border border-white/10 bg-black/30 p-4">
      <h4 class="text-sm font-bold text-yellow-500 uppercase tracking-wider mb-3" data-i18n="info.siegesTab.castleList">Castillos</h4>
      <div class="flex flex-wrap gap-2">
        {castleList.map((castle) => (
          <span class="px-3 py-1 bg-black/40 rounded border border-yellow-500/20 text-yellow-400 text-xs font-medium">{castle}</span>
        ))}
      </div>
    </div>
  </div>
</div>

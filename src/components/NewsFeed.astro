---
import { orderedNews } from '../data/news';
import { newsWebpSrcset } from '../utils/news-images';
import CardSurface from './ui/CardSurface.astro';
import SectionHeading from './ui/SectionHeading.astro';
import { visitorLangFromPath } from '../utils/i18n-lang';
import { translate } from '../utils/translations';

const lang = visitorLangFromPath(Astro.url.pathname);
const preview = orderedNews.slice(0, 3);
---

<section class="py-14 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <SectionHeading text="Últimas Noticias" i18nKey="news.title" className="mb-10" />

    <div class="max-w-6xl mx-auto">
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          preview.map((item) => {
            const previewTitle = item.titleKey
              ? translate(item.titleKey, lang, item.title)
              : item.title;
            const alt = `${previewTitle} - L2Titan Lineage 2 Interlude`;
            const webpSrcset = newsWebpSrcset(item);
            return (
            <article class="h-full">
              <CardSurface className="overflow-hidden border-white/10 transition-colors duration-300 hover:border-yellow-500/25 h-full flex flex-col">
                <div class="h-52 overflow-hidden">
                  {item.imageCard && webpSrcset ? (
                    <img
                      src={item.imageCard}
                      srcset={webpSrcset}
                      sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 400px"
                      alt={alt}
                      width="600"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  ) : (
                    <img
                      src={item.image}
                      alt={alt}
                      width="960"
                      height="224"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover"
                    />
                  )}
                </div>
                <div class="p-5 grow flex flex-col">
                  <div class="text-yellow-500 text-xs font-bold uppercase tracking-wider mb-2">
                    {item.dateLabel}
                  </div>
                  <h3 class="text-lg md:text-xl font-bold text-white mb-3 font-display uppercase tracking-wide group-hover:text-yellow-400 transition-colors">
                    {item.titleKey ? (
                      <span data-i18n={item.titleKey}>{translate(item.titleKey, lang, item.title)}</span>
                    ) : (
                      item.title
                    )}
                  </h3>
                  <p class="text-gray-400 text-sm leading-relaxed grow">
                    {item.summaryKey ? (
                      <span data-i18n={item.summaryKey}>{translate(item.summaryKey, lang, item.summary)}</span>
                    ) : (
                      item.summary
                    )}
                  </p>
                  <a
                    href={`/news/${item.slug}`}
                    class="inline-block mt-4 text-yellow-500 hover:text-yellow-300 text-xs md:text-sm font-bold uppercase tracking-wider transition-colors"
                    data-i18n="news.readMore"
                  >
                    Leer más →
                  </a>
                </div>
              </CardSurface>
            </article>
            );
          })
        }
      </div>

      <div class="mt-8 text-center">
        <a
          href="/news"
          class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-yellow-400 hover:text-yellow-300 transition-colors"
          data-i18n="news.viewAll"
        >
          Ver todas las noticias
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

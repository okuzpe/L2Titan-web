---
import { visitorLangFromPath } from "../utils/i18n-lang";
import { translate } from "../utils/translations";
import { DISCORD_URL, FACEBOOK_URL, INSTAGRAM_URL, TIKTOK_URL } from "../utils/seo";
import VoteModal from "./ui/VoteModal.astro";

const lang = visitorLangFromPath(Astro.url.pathname);
const year = new Date().getFullYear();
---

<footer class="bg-slate-900 border-t border-white/10 mt-auto">
  <div class="max-w-7xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
    <!-- Banners de votación; id para ancla desde el nav (usar href="#vote-section", no /#…, para no forzar la home) -->
    <div id="vote-section" class="mb-8 pb-8 border-b border-white/10">
      <h3
        class="text-sm font-semibold text-yellow-500 uppercase tracking-wider mb-4 text-center font-display"
        data-i18n="footer.voteForUs"
      >
        {translate("footer.voteForUs", lang, "Vota por nosotros")}
      </h3>
      <div class="flex flex-wrap justify-center items-center gap-4">
        <!-- Banner HopZone -->
        <a
          href="https://l2.hopzone.net/site/vote/107098/1"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity"
          title="L2.HOPZONE.NET – Lineage 2 Servers ranking"
        >
          <img
            src="https://l2.hopzone.net/assets/img/banners/vote_banners/banner_5.png"
            alt="Vote for L2-TITAN.COM"
            class="border-0"
            style="width: 140px; height: 120px;"
            width="140"
            height="120"
            loading="lazy"
            decoding="async"
          />
        </a>

        <!-- Banner l2topzone -->
        <a
          href="https://l2topzone.com/vote/id/13387"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity"
          title="l2topzone"
        >
          <img
            src="/images/Topzone-button.gif"
            alt="l2topzone.com"
            width="140"
            height="120"
            class="border-0"
            loading="lazy"
            decoding="async"
          />
        </a>

        <!-- L2Network: snippet oficial en HTML (recheck); clic → modal con &id=nombre PJ -->
        <a
          id="l2network-btn"
          href="https://l2network.eu/index.php?a=in&u=l2-titan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity cursor-pointer"
          title="L2Network"
        >
          <img
            src="https://l2network.eu/button.php?u=l2-titan&buttontype=static"
            alt="L2Network"
            class="border-0 h-auto max-w-full"
            width="145"
            height="122"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
      <!-- Banner Top100Arena + L2JBrasil -->
      <div class="flex flex-wrap justify-center items-center gap-4 mt-4">
        <a
          id="top100arena-btn"
          href="https://www.top100arena.com/listing/102116"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity cursor-pointer"
          title="Top100Arena"
        >
          <img
            src="https://www.top100arena.com/rankbadge/102116"
            alt="Lineage 2 private server"
            width="150"
            height="45"
            class="w-[150px] h-auto max-w-full"
            loading="lazy"
            decoding="async"
          />
        </a>

        <a
          id="top-l2jbrasil-btn"
          href="https://top.l2jbrasil.com/index.php?a=in&u=Titan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity cursor-pointer"
          title="Top L2JBrasil de Servidores de Lineage2"
        >
          <img
            src="/images/L2JBrazil-button.png"
            alt="Top L2JBrasil de Servidores de Lineage2"
            class="border-0"
            width="140"
            height="120"
            loading="lazy"
            decoding="async"
          />
        </a>

        <!-- L2HopZone: banner remoto a veces 404 hasta activar el listing; fallback local en public/images -->
        <a
          href="https://l2hopzone.com/vote/s403672903"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity"
          title="Vote for L2-Titan"
        >
          <img
            src="/images/l2hopzone-vote-fallback.png"
            alt="L2HopZone — votar por L2-Titan"
            width="200"
            height="60"
            class="border-0"
            loading="lazy"
            decoding="async"
          />
        </a>

        <a
          href="https://www.arena-top100.com/index.php?a=in&u=L2Titan"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity"
          title="Arena-Top100 — Lineage 2 Private Servers"
        >
          <img
            src="https://www.arena-top100.com/images/vote/lineage2-private-servers.png"
            alt="Arena-Top100 — Lineage 2 Private Servers"
            width="88"
            height="53"
            class="border-0"
            loading="lazy"
            decoding="async"
          />
        </a>

        {
          /*
        <a
          href="https://en.l2top.info"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block hover:opacity-80 transition-opacity"
          title="L2 Top 200 [2024 TOP]: lineage 2 top servers List"
        >
          <img
            src="https://en.l2top.info/img/L2TOP-INFO-180x54.gif"
            alt="L2 Top 200 — Lineage 2 top servers list"
            width="180"
            height="54"
            decoding="async"
            class="border-0"
            loading="lazy"
          />
        </a>
        */
        }
      </div>
    </div>

    <!-- Modales de voto (cableado abajo en initVoteModal por id `${prefix}-*`) -->
    <VoteModal
      prefix="top100arena"
      title="Top100Arena"
      badgeSrc="https://www.top100arena.com/rankbadge/102116"
      badgeAlt="Top100Arena"
      badgeWidth={150}
      badgeHeight={45}
      badgeClass="mx-auto mb-3 w-[150px] h-auto max-w-full"
    />

    <VoteModal
      prefix="l2network"
      title="L2Network"
      badgeSrc="https://l2network.eu/button.php?u=l2-titan&buttontype=static"
      badgeAlt="L2Network"
      badgeWidth={145}
      badgeHeight={122}
      badgeClass="mx-auto mb-3 h-auto max-w-full border-0"
      badgeLazy
    />

    <VoteModal
      prefix="top-l2jbrasil"
      title="Top L2JBrasil"
      badgeSrc="/images/L2JBrazil-button.png"
      badgeAlt="Top L2JBrasil"
      badgeClass="mx-auto mb-3"
      badgeLazy
      noteKey="footer.l2jbrasilExactNameRule"
    />

    <script is:inline>
      (function () {
        function initVoteModal(prefix, baseUrl, paramBuilder) {
          var btn = document.getElementById(prefix + "-btn");
          var modal = document.getElementById(prefix + "-modal");
          var backdrop = document.getElementById(prefix + "-backdrop");
          var closeBtn = document.getElementById(prefix + "-close");
          var form = document.getElementById(prefix + "-form");
          var nameInput = document.getElementById(prefix + "-name");
          if (!btn || !modal || !backdrop || !closeBtn || !form || !nameInput)
            return;

          function openModal() {
            nameInput.value = "";
            modal.classList.remove("hidden");
            modal.classList.add("flex");
            nameInput.focus();
          }

          // restoreFocus=true devuelve el foco al disparador (cierres iniciados por el usuario).
          function closeModal(restoreFocus) {
            modal.classList.add("hidden");
            modal.classList.remove("flex");
            if (restoreFocus) btn.focus();
          }

          btn.addEventListener("click", function (e) {
            e.preventDefault();
            openModal();
          });
          backdrop.addEventListener("click", function () {
            closeModal(true);
          });
          closeBtn.addEventListener("click", function () {
            closeModal(true);
          });

          document.addEventListener("keydown", function (e) {
            if (e.key === "Escape" && !modal.classList.contains("hidden")) {
              closeModal(true);
            }
          });

          form.addEventListener("submit", function (e) {
            e.preventDefault();
            var name = nameInput.value.trim();
            if (!name) return;
            window.open(baseUrl + paramBuilder(name), "_blank");
            setTimeout(closeModal, 100);
          });
        }

        function init() {
          initVoteModal(
            "top100arena",
            "https://www.top100arena.com/listing/102116/vote?incentive=",
            function (n) {
              return encodeURIComponent(n);
            },
          );
          initVoteModal(
            "l2network",
            "https://l2network.eu/index.php?a=in&u=l2-titan&id=",
            function (n) {
              return encodeURIComponent(n);
            },
          );
          initVoteModal(
            "top-l2jbrasil",
            "https://top.l2jbrasil.com/index.php?a=in&u=Titan&player_id=",
            function (n) {
              return encodeURIComponent(n);
            },
          );
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", init);
        } else {
          init();
        }
      })();
    </script>

    <div
      class="flex flex-wrap justify-center gap-x-5 gap-y-2 text-sm text-gray-300 mb-6 max-w-4xl mx-auto px-2"
    >
      <a
        href="/info"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="navbar.info">{translate("navbar.info", lang, "Info")}</a
      >
      <a
        href="/features"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkFeatures"
        >{translate("footer.linkFeatures", lang, "Features")}</a
      >
      <a
        href="/faq"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkFaq">{translate("footer.linkFaq", lang, "FAQ")}</a
      >
      <a
        href="/registro"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkAccount"
        >{translate("footer.linkAccount", lang, "Cuenta")}</a
      >
      <a
        href="/downloads"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkDownloads"
        >{translate("footer.linkDownloads", lang, "Descargas")}</a
      >
      <a
        href="/news"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkNews"
        >{translate("footer.linkNews", lang, "Noticias")}</a
      >
      <a
        href="/comunidad"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkCommunity"
        >{translate("footer.linkCommunity", lang, "Comunidad")}</a
      >
      <a
        href={lang === "en" ? "/en/about" : "/about"}
        class="hover:text-yellow-400 transition-colors"
        data-i18n="about.heading"
        >{translate("about.heading", lang, "Sobre L2Titan")}</a
      >
      <a
        href="/substack"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkSubstack"
        >{translate("footer.linkSubstack", lang, "MultiSkill")}</a
      >
      <a
        href="/rates"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkRates"
        >{translate("footer.linkRates", lang, "Rates")}</a
      >
      <a
        href="/en/substack"
        class="hover:text-yellow-400 transition-colors"
        data-i18n="footer.linkSubstackEn"
        >{translate("footer.linkSubstackEn", lang, "MultiSkill")}</a
      >
    </div>

    <!-- Copyright y Redes -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-gray-400 text-sm">&copy; {year} L2Titan.com.</div>
      <div
        id="social-media"
        class="flex flex-wrap items-center justify-center gap-3"
      >
        <a
          href={FACEBOOK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-linear-to-r from-[#1b74e4] to-[#0f4ea8] text-white font-bold overflow-hidden shadow-[0_0_20px_rgba(27,116,228,0.3)] transition-all hover:shadow-[0_0_35px_rgba(27,116,228,0.55)]"
        >
          <span class="sr-only">Facebook</span>
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M22 12a10 10 0 10-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.5-3.88 3.79-3.88 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0022 12z"
            ></path>
          </svg>
          <span class="text-sm tracking-wide">Facebook</span>
        </a>
        <a
          href={INSTAGRAM_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-linear-to-r from-[#fd1d1d] via-[#d62976] to-[#f58529] text-white font-bold overflow-hidden shadow-[0_0_20px_rgba(214,41,118,0.3)] transition-all hover:shadow-[0_0_35px_rgba(214,41,118,0.55)]"
        >
          <span class="sr-only">Instagram</span>
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M7.75 2h8.5A5.75 5.75 0 0122 7.75v8.5A5.75 5.75 0 0116.25 22h-8.5A5.75 5.75 0 012 16.25v-8.5A5.75 5.75 0 017.75 2zm0 1.8A3.95 3.95 0 003.8 7.75v8.5a3.95 3.95 0 003.95 3.95h8.5a3.95 3.95 0 003.95-3.95v-8.5a3.95 3.95 0 00-3.95-3.95h-8.5zm8.8 1.35a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4zM12 7a5 5 0 110 10 5 5 0 010-10zm0 1.8a3.2 3.2 0 100 6.4 3.2 3.2 0 000-6.4z"
            ></path>
          </svg>
          <span class="text-sm tracking-wide">Instagram</span>
        </a>
        <a
          href={TIKTOK_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-linear-to-r from-[#fe2c55] to-[#00c9d6] text-white font-bold overflow-hidden shadow-[0_0_20px_rgba(254,44,85,0.3)] transition-all hover:shadow-[0_0_35px_rgba(254,44,85,0.55)]"
        >
          <span class="sr-only">TikTok</span>
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"
            ></path>
          </svg>
          <span class="text-sm tracking-wide">TikTok</span>
        </a>
        <a
          href={DISCORD_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-linear-to-r from-[#5865F2] to-[#3c45af] text-white font-bold overflow-hidden shadow-[0_0_20px_rgba(88,101,242,0.3)] transition-all hover:shadow-[0_0_35px_rgba(88,101,242,0.55)]"
        >
          <span class="sr-only">Discord</span>
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.5328-9.748-2.312-13.7083a.0765.0765 0 00-.0303-.0277zM6.4544 14.7698c-1.1985 0-2.152-1.1006-2.152-2.451 0-1.3504.9355-2.451 2.152-2.451 1.2238 0 2.1718 1.1006 2.152 2.451 0 1.3504-.9281 2.451-2.152 2.451zm6.585 0c-1.1985 0-2.152-1.1006-2.152-2.451 0-1.3504.9354-2.451 2.152-2.451 1.2238 0 2.1718 1.1006 2.152 2.451 0 1.3504-.928 2.451-2.152 2.451z"
            ></path>
          </svg>
          <span class="text-sm tracking-wide">Discord</span>
        </a>
      </div>
    </div>
  </div>
</footer>

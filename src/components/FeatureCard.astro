---
import CardSurface from "./ui/CardSurface.astro";
import { visitorLangFromPath } from "../utils/i18n-lang";
import { translate } from "../utils/translations";

interface Props {
  title: string;
  description: string;
  /** Clave de icono SVG (sin emoji): premium y consistente entre SO */
  icon: 'substack' | 'autofarm' | 'economy' | 'events' | 'instances' | 'pvp';
  titleKey?: string;
  descriptionKey?: string;
}

const { title, description, icon, titleKey, descriptionKey } = Astro.props;
const lang = visitorLangFromPath(Astro.url.pathname);
const resolvedTitle = titleKey ? translate(titleKey, lang, title) : title;
const resolvedDescription = descriptionKey
  ? translate(descriptionKey, lang, description)
  : description;

/** Paths estilo Heroicons outline (viewBox 24, stroke currentColor). */
const ICON_PATHS: Record<Props['icon'], string> = {
  substack:
    'M6.429 9.75 2.25 12l4.179 2.25m0-4.5 5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0 4.179 2.25L12 21.75 2.25 14.25l4.179-2.25',
  autofarm: 'm3.75 13.5 9.75-9.75v6.75h6.75L9.75 20.25V13.5H3.75Z',
  economy:
    'M12 6v12m-3-2.818.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  events:
    'M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z',
  instances:
    'M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5',
  pvp: 'M14.25 6.087c0-.355.186-.676.401-.959.221-.29.349-.634.349-1.003 0-1.036-1.007-1.875-2.25-1.875s-2.25.84-2.25 1.875c0 .369.128.713.349 1.003.215.283.401.604.401.959v0a.64.64 0 0 1-.657.643 48.39 48.39 0 0 1-4.163-.3c.186 1.613.293 3.25.315 4.907a.656.656 0 0 1-.658.663v0c-.355 0-.676-.186-.959-.401a1.647 1.647 0 0 0-1.003-.349c-1.036 0-1.875 1.007-1.875 2.25s.84 2.25 1.875 2.25c.369 0 .713-.128 1.003-.349.283-.215.604-.401.959-.401v0c.31 0 .555.26.532.57a48.039 48.039 0 0 1-.642 5.056c1.518.19 3.058.309 4.616.354a.64.64 0 0 0 .657-.643v0c0-.355-.186-.676-.401-.959a1.647 1.647 0 0 1-.349-1.003c0-1.035 1.008-1.875 2.25-1.875 1.243 0 2.25.84 2.25 1.875 0 .37-.128.713-.349 1.003-.215.283-.4.604-.4.959v0c0 .333.277.599.61.58a48.1 48.1 0 0 0 5.427-.63 48.05 48.05 0 0 0 .582-4.717.532.532 0 0 0-.533-.57v0c-.355 0-.676.186-.959.401-.29.221-.634.349-1.003.349-1.035 0-1.875-1.007-1.875-2.25s.84-2.25 1.875-2.25c.37 0 .713.128 1.003.349.283.215.604.401.959.401v0a.656.656 0 0 0 .659-.663 47.703 47.703 0 0 0-.31-4.82c-1.444.10-2.91.16-4.39.17',
};
const iconPath = ICON_PATHS[icon] ?? ICON_PATHS.substack;
---

<CardSurface className="df-card-interactive p-6 md:p-7 group">
  <div class="w-11 h-11 bg-yellow-500/10 rounded-lg flex items-center justify-center mb-4 text-yellow-500 border border-yellow-500/20">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d={iconPath} />
    </svg>
  </div>
  <h3 class="text-lg md:text-xl df-title mb-2">
    {titleKey ? <span data-i18n={titleKey}>{resolvedTitle}</span> : resolvedTitle}
  </h3>
  <p class="text-gray-400 text-sm leading-relaxed">
    {descriptionKey ? <span data-i18n={descriptionKey}>{resolvedDescription}</span> : resolvedDescription}
  </p>
</CardSurface>
